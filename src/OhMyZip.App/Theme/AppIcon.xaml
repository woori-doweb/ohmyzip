<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ohmyZip 아이콘 정본(64×64 격자). 이마에 지퍼를 단 말랑한 주머니가 "오 마이!" 하고 놀란 얼굴.
        앱 안 로고(Controls/AppLogo)와 실행 파일 아이콘(ohmyZip.ico, packaging/make_icon.ps1 로 생성)이 모두 이 그림을 쓴다.
        색은 테마와 무관하게 고정(아이콘은 어느 배경에서나 같은 모습이어야 한다).
        32px 이하(ico 16·20·24·32)는 Oz.AppIconSmall: 같은 몸통·지퍼·얼굴에서 작은 장식을 뺀 단순판.
    -->
    <DrawingImage x:Key="Oz.AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 크기 고정용 투명 바탕 -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />

                <!-- 몸통: 아래로 살짝 퍼진 말랑한 주머니 -->
                <GeometryDrawing Geometry="M18,7 H46 C54,7 58,11 58.5,19 L60,44 C60.5,53 55,58.5 46,58.5 H18 C9,58.5 3.5,53 4,44 L5.5,19 C6,11 10,7 18,7 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFE066" Offset="0" />
                            <GradientStop Color="#FFB443" Offset="0.55" />
                            <GradientStop Color="#FF8A3D" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E0672A" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- 지퍼 띠 -->
                <GeometryDrawing Brush="#7A3A14">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="5.6,17 52.8,6" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 지퍼 이빨(위아래 엇갈림) -->
                <GeometryDrawing Brush="#FFF4D6"
                                 Geometry="M8,17.6 h2.6 v2.2 h-2.6 Z M13,20.2 h2.6 v2.2 h-2.6 Z M18,17.6 h2.6 v2.2 h-2.6 Z M23,20.2 h2.6 v2.2 h-2.6 Z M28,17.6 h2.6 v2.2 h-2.6 Z M33,20.2 h2.6 v2.2 h-2.6 Z" />
                <!-- 열린 쪽: 이빨 사이가 벌어진 부분 -->
                <GeometryDrawing Brush="#FFF4D6"
                                 Geometry="M48.5,17.4 h2.6 v1.9 h-2.6 Z M53,17.4 h2.6 v1.9 h-2.6 Z M48.5,20.7 h2.6 v1.9 h-2.6 Z M53,20.7 h2.6 v1.9 h-2.6 Z" />

                <!-- 지퍼 손잡이(슬라이더 + 늘어진 고리) -->
                <GeometryDrawing Brush="#FFFFFF" Geometry="M38,14.5 H46 C47.2,14.5 47.8,15.2 47.6,16.4 L46.6,24 C46.4,25 45.8,25.5 44.8,25.5 H39.2 C38.2,25.5 37.6,25 37.4,24 L36.4,16.4 C36.2,15.2 36.8,14.5 38,14.5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#7A3A14" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M39.4,25 H44.6 C45.6,25 46.2,25.6 46.1,26.6 L45.4,33.4 C45.3,34.6 44.4,35.4 43.2,35.4 H40.8 C39.6,35.4 38.7,34.6 38.6,33.4 L37.9,26.6 C37.8,25.6 38.4,25 39.4,25 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#7A3A14" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#7A3A14">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="40.6,28.2 2.8,4.4" RadiusX="1.4" RadiusY="1.4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 놀라서 치켜 올라간 눈썹 -->
                <GeometryDrawing Geometry="M14.5,29.5 Q18.5,26 23,28.2 M27.5,28.2 Q31,26 34.5,28.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#5A2A10" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- 동그란 눈 -->
                <GeometryDrawing Brush="#3A2216">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="19,37.5" RadiusX="5" RadiusY="5.8" />
                            <EllipseGeometry Center="31,37.5" RadiusX="5" RadiusY="5.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 눈 반짝임 -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="17.2,35.3" RadiusX="2" RadiusY="2.2" />
                            <EllipseGeometry Center="29.2,35.3" RadiusX="2" RadiusY="2.2" />
                            <EllipseGeometry Center="20.9,40" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="32.9,40" RadiusX="0.9" RadiusY="0.9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 볼터치 -->
                <GeometryDrawing Brush="#80FF5C8A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="11.5,46" RadiusX="4" RadiusY="2.6" />
                            <EllipseGeometry Center="38.5,46" RadiusX="4" RadiusY="2.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- "오!" 하고 벌린 입 + 혀 -->
                <GeometryDrawing Brush="#3A2216">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="25,48.5" RadiusX="3.4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF6F8E" Geometry="M22.4,50.4 C23.4,49.2 26.6,49.2 27.6,50.4 C27,52 25.8,52.5 25,52.5 C24.2,52.5 23,52 22.4,50.4 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 32px 이하용 단순판(64×64 격자). 선·간격은 16px 에서 1px 이상이 되도록 4 이상. -->
    <DrawingImage x:Key="Oz.AppIconSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 크기 고정용 투명 바탕 -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />

                <!-- 몸통: 큰 판과 같은 실루엣, 단색 + 굵은 테두리 -->
                <GeometryDrawing Brush="#FFB443" Geometry="M18,7 H46 C54,7 58,11 58.5,19 L60,44 C60.5,53 55,58.5 46,58.5 H18 C9,58.5 3.5,53 4,44 L5.5,19 C6,11 10,7 18,7 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E0672A" Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- 지퍼 띠(이빨 없음). 몸통 테두리 안쪽 끝에서 멈춰 테두리 두께 4 를 덮지 않는다. -->
                <GeometryDrawing Brush="#7A3A14">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,16 48,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 지퍼 손잡이 하나 -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="42,12 8,18" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#7A3A14" Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- 두 눈 + 입 -->
                <GeometryDrawing Brush="#3A2216">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18,39" RadiusX="6" RadiusY="6" />
                            <EllipseGeometry Center="34,39" RadiusX="6" RadiusY="6" />
                            <EllipseGeometry Center="26,52" RadiusX="3" RadiusY="3" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
