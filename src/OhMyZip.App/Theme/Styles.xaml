<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 글꼴: Windows 내장만 사용(SF Pro·SF Symbols 번들 금지). -->
    <FontFamily x:Key="Oz.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Oz.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Oz.BodySize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
    <sys:Double x:Key="Oz.SecondarySize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:Double>

    <!-- 키보드 포커스 표시(마우스 클릭에는 나타나지 않음). -->
    <Style x:Key="Oz.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource Oz.Focus}" StrokeThickness="2" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oz.InsetFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" Stroke="{DynamicResource Oz.Focus}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Oz.WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Oz.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Oz.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Oz.BodySize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Oz.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource Oz.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Oz.SecondarySize}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="MaxWidth" Value="360" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 툴바 버튼: 아이콘 글리프(Tag) + 짧은 라벨(Content). 클릭 대상 ≥ 32×32 DIP. -->
    <Style x:Key="Oz.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Oz.ChromeText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Oz.FocusVisual}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Oz.IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" TextElement.FontSize="{StaticResource Oz.SecondarySize}" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 주요 동작(풀기) 하나만 강조색. -->
    <Style x:Key="Oz.ToolbarAccentButton" TargetType="Button" BasedOn="{StaticResource Oz.ToolbarButton}">
        <Setter Property="Foreground" Value="{DynamicResource Oz.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Oz.IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" TextElement.FontSize="{StaticResource Oz.SecondarySize}" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Oz.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 툴바 '작게': 아이콘만(라벨은 툴팁·AutomationProperties.Name). 클릭 대상 32×32 DIP. -->
    <Style x:Key="Oz.ToolbarSmallButton" TargetType="Button" BasedOn="{StaticResource Oz.ToolbarButton}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Oz.IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Oz.ToolbarSmallAccentButton" TargetType="Button" BasedOn="{StaticResource Oz.ToolbarSmallButton}">
        <Setter Property="Foreground" Value="{DynamicResource Oz.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Oz.IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 툴바 '구식': 글자만, 테두리 있는 고전 단추. -->
    <Style x:Key="Oz.ToolbarClassicButton" TargetType="Button" BasedOn="{StaticResource Oz.ToolbarButton}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Oz.ToolbarClassicAccentButton" TargetType="Button" BasedOn="{StaticResource Oz.ToolbarClassicButton}">
        <Setter Property="Foreground" Value="{DynamicResource Oz.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 대화상자·빈 화면 버튼. -->
    <Style x:Key="Oz.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Oz.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Oz.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Oz.IconButton" TargetType="Button" BasedOn="{StaticResource Oz.Button}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Oz.IconFont}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="Oz.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Oz.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Oz.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Oz.Focus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴: 다크/고대비에서도 읽히도록 자체 템플릿(Windows 표준 메뉴 막대 동작은 그대로). -->
    <Style x:Key="Oz.Menu" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Oz.Chrome}" />
        <Setter Property="Foreground" Value="{DynamicResource Oz.ChromeText}" />
        <Setter Property="FontFamily" Value="{StaticResource Oz.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Oz.BodySize}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Oz.ChromeText}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,5" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CheckCol" Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OzGesture" />
                                <ColumnDefinition x:Name="ArrowCol" Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Oz.IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="32,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Oz.IconFont}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" AllowsTransparency="False" Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Oz.Background}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="1" Padding="2" MinWidth="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" TextElement.Foreground="{DynamicResource Oz.Text}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Padding" Value="10,5" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Padding" Value="10,5" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Oz.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 사이드바 트리. -->
    <Style x:Key="Oz.TreeView" TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Oz.Sidebar}" />
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
    </Style>

    <!-- 파일 목록. 행 높이 28 DIP, 불투명. -->
    <Style x:Key="Oz.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Oz.Background}" />
        <Setter Property="RowBackground" Value="{DynamicResource Oz.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Oz.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <!-- ICollectionView 의 CurrentItem(첫 행)을 선택으로 동기화하지 않는다(DEF-01). -->
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ClipboardCopyMode" Value="None" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Oz.SecondaryText}" />
        <Setter Property="Background" Value="{DynamicResource Oz.Background}" />
        <Setter Property="FontSize" Value="{StaticResource Oz.SecondarySize}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <TextBlock x:Name="SortGlyph" Grid.Column="1" FontFamily="{StaticResource Oz.IconFont}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Opacity="0" Cursor="SizeWE" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Opacity="0" Cursor="SizeWE" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70E;" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70D;" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding TypeName}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Oz.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Oz.InsetFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Oz.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Oz.OnSelection}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 간단히·아이콘 목록과 찾기 결과 항목: 토큰 선택색(색 + 선택 상태는 UIA SelectionItem 으로도 노출). -->
    <Style x:Key="Oz.EntryListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Oz.InsetFocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Oz.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource Oz.OnSelection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
