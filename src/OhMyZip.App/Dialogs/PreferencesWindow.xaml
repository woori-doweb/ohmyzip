<Window x:Class="OhMyZip.App.Dialogs.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Oz.WindowStyle}"
        Title="환경 설정" Width="720" Height="500" MinWidth="600" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-PreferencesWindow">
    <Window.Resources>
        <Style x:Key="Pref.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Pref.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Pref.Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Oz.SecondaryText}" />
            <Setter Property="FontSize" Value="{StaticResource Oz.SecondarySize}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="초기화…" Style="{StaticResource Oz.Button}" Margin="0" Click="OnReset" AutomationProperties.AutomationId="OZ-Pref-Reset"
                    ToolTip="모든 ohmyZip 설정을 기본값으로 되돌립니다(확인을 먼저 묻습니다)." />
            <Button DockPanel.Dock="Right" Content="취소" IsCancel="True" Style="{StaticResource Oz.Button}" AutomationProperties.AutomationId="OZ-Pref-Cancel" />
            <Button DockPanel.Dock="Right" Content="확인" IsDefault="True" Style="{StaticResource Oz.Button}" Click="OnOk" AutomationProperties.AutomationId="OZ-Pref-Ok" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Oz.Border}" />

        <!-- 설정 범주 9개(순서 고정, OZ-U10). -->
        <Border DockPanel.Dock="Left" Width="170" Background="{DynamicResource Oz.Sidebar}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,1,0">
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="4,8" Foreground="{DynamicResource Oz.Text}"
                     SelectionChanged="OnCategoryChanged" AutomationProperties.Name="설정 범주" AutomationProperties.AutomationId="OZ-Pref-Categories">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid x:Name="Pages">
                <!-- 0 일반 설정 -->
                <StackPanel>
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="일반 설정" />
                    <CheckBox x:Name="ShowStartScreenBox" Content="시작 시 시작 화면 표시" AutomationProperties.AutomationId="OZ-Pref-ShowStartScreen" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="끄면 압축 파일 없이 시작할 때 안내 화면 대신 빈 창이 열립니다(F6 으로 언제든 볼 수 있음)." />
                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource Pref.Label}" Text="테마 (앱 내부 설정):" />
                    <ComboBox x:Name="ThemeBox" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" AutomationProperties.AutomationId="OZ-Pref-Theme" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="Windows 설정은 바꾸지 않습니다. 고대비 테마가 켜져 있으면 항상 시스템 색을 씁니다." />
                    <CheckBox x:Name="ReduceMotionBox" Content="동작 줄이기 (앱 내부 설정)" Margin="0,14,0,0" AutomationProperties.AutomationId="OZ-Pref-ReduceMotion" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="진행 창의 움직이는 막대를 쓰지 않습니다. Windows 의 '애니메이션 표시' 끔도 같은 효과입니다." />
                </StackPanel>

                <!-- 1 파일 연결 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="파일 연결" />
                    <TextBlock x:Name="FileAssocStatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-FileAssoc"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="FileAssocExtensionsText" Style="{StaticResource Pref.Note}" Margin="0,10,0,0" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Extensions" />
                    <TextBlock Style="{StaticResource Pref.Note}"
                               Text="Windows 는 프로그램이 기본 프로그램을 직접 바꾸지 못하게 합니다. 등록하면 ohmyZip 이 Windows 기본 앱 목록에 나타나고, 열린 설정에서 ohmyZip 을 고르면 기본 프로그램이 됩니다. 현재 사용자 범위에만 기록하며 관리자 권한이 필요하지 않습니다." />
                    <WrapPanel Orientation="Horizontal" Margin="-4,14,0,0">
                        <Button x:Name="FileAssocRegisterButton" Content="ohmyZip 을 기본 프로그램으로 등록…" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocRegister" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Register" />
                        <Button x:Name="FileAssocUnregisterButton" Content="등록 해제" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocUnregister" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Unregister" />
                        <Button Content="Windows 기본 앱 설정 열기" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocOpenSettings" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-OpenSettings" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Pref.Note}"
                               Text="이 페이지의 단추는 누르는 즉시 적용됩니다. 아래 확인·취소와는 관계없습니다." />
                </StackPanel>

                <!-- 2 탐색기 메뉴 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="탐색기 메뉴" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-ShellMenu"
                               Text="&#x24D8; 시스템 등록은 사용자 동의 후 — 준비 중. 지금은 탐색기 오른쪽 클릭 메뉴를 등록하지 않습니다." />
                </StackPanel>

                <!-- 3 압축 풀기 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="압축 풀기" />
                    <TextBlock x:Name="DestinationLabel" Style="{StaticResource Pref.Label}" Text="기본 해제 위치:" Margin="0,0,0,4" />
                    <ComboBox x:Name="DestinationBox" AutomationProperties.LabeledBy="{Binding ElementName=DestinationLabel}" AutomationProperties.AutomationId="OZ-Pref-ExtractDestination" />
                    <TextBlock x:Name="ConflictLabel" Style="{StaticResource Pref.Label}" Text="같은 이름의 파일이 있을 때 기본 동작:" />
                    <ComboBox x:Name="ConflictBox" AutomationProperties.LabeledBy="{Binding ElementName=ConflictLabel}" AutomationProperties.AutomationId="OZ-Pref-ExtractConflict" />
                    <CheckBox x:Name="OpenAfterBox" Content="풀고 나서 폴더 열기" Margin="0,14,0,0" AutomationProperties.AutomationId="OZ-Pref-OpenFolderAfterExtract" />
                </StackPanel>

                <!-- 4 압축하기 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="압축하기" />
                    <TextBlock x:Name="FormatLabel" Style="{StaticResource Pref.Label}" Text="기본 형식:" Margin="0,0,0,4" />
                    <ComboBox x:Name="FormatBox" AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}" AutomationProperties.AutomationId="OZ-Pref-CreateFormat" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="아직 만들 수 없는 형식을 고르면 새 압축 대화상자에서 그 이유를 보여 줍니다." />
                    <TextBlock x:Name="LevelLabel" Style="{StaticResource Pref.Label}" Text="기본 압축 레벨:" />
                    <ComboBox x:Name="LevelBox" AutomationProperties.LabeledBy="{Binding ElementName=LevelLabel}" AutomationProperties.AutomationId="OZ-Pref-CreateLevel" />
                </StackPanel>

                <!-- 5 보기/편집 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="보기/편집" />
                    <CheckBox x:Name="ConfirmDeleteBox" Content="압축 파일 안의 항목을 삭제하기 전에 확인" Margin="0" AutomationProperties.AutomationId="OZ-Pref-ConfirmDelete" />
                    <TextBlock x:Name="ListModeLabel" Style="{StaticResource Pref.Label}" Text="파일 목록 방식:" Margin="0,14,0,4" />
                    <ComboBox x:Name="ListModeBox" AutomationProperties.LabeledBy="{Binding ElementName=ListModeLabel}" AutomationProperties.AutomationId="OZ-Pref-ListMode" />
                    <TextBlock Style="{StaticResource Pref.Label}" Text="칼럼 표시 (자세히 방식):" Margin="0,14,0,0" />
                    <WrapPanel x:Name="ColumnPanel" Orientation="Horizontal" AutomationProperties.Name="칼럼 표시" AutomationProperties.AutomationId="OZ-Pref-Columns" />
                </StackPanel>

                <!-- 6 보안 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="보안 설정" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-Security"
                               Text="&#x24D8; 암호 관리자·악성코드 검사 설정은 준비 중입니다. 입력한 암호는 열린 압축 파일에 대해서만 메모리에 두고, 설정 파일이나 기록에 저장하지 않습니다." />
                </StackPanel>

                <!-- 7 고급 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="고급 설정" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-Advanced"
                               Text="&#x24D8; 고급 설정은 준비 중입니다. 해제 안전 한도는 엔진 기본값(전체 8GB, 항목 200,000개)으로 고정되어 있습니다." />
                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource Pref.Note}" Margin="0,12,0,0" AutomationProperties.AutomationId="OZ-Pref-SettingsPath" />
                </StackPanel>

                <!-- 8 언어 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="언어 설정" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-Language" Text="&#x24D8; 한국어만 지원합니다." />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
