<Window x:Class="OhMyZip.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Oz.WindowStyle}"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-MessageDialog">
    <Grid Margin="20,20,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 아이콘 + 문장: 색만으로 의미를 전하지 않는다. -->
        <TextBlock x:Name="IconGlyph" Grid.RowSpan="2" FontFamily="{StaticResource Oz.IconFont}" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Text, ElementName=KindText}" AutomationProperties.AutomationId="OZ-Message-Icon" />
        <TextBlock x:Name="KindText" Visibility="Collapsed" />
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Message-Heading" />
            <TextBlock x:Name="BodyText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Oz.Text}" AutomationProperties.AutomationId="OZ-Message-Body" />
        </StackPanel>

        <ListBox x:Name="ProblemList" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" MaxHeight="220" MinWidth="320"
                 Background="{DynamicResource Oz.Background}" Foreground="{DynamicResource Oz.Text}" BorderBrush="{DynamicResource Oz.Border}"
                 AutomationProperties.Name="문제 목록" AutomationProperties.AutomationId="OZ-Message-Details" Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <StackPanel x:Name="ButtonPanel" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
