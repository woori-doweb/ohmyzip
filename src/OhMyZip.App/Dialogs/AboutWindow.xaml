<Window x:Class="OhMyZip.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OhMyZip.App.Controls"
        Style="{StaticResource Oz.WindowStyle}"
        Title="ohmyZip 정보" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-AboutWindow">
    <StackPanel Margin="24,22,24,18">
        <StackPanel Orientation="Horizontal">
            <controls:AppLogo Width="56" Height="56" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ohmyZip" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                           AutomationProperties.AutomationId="OZ-About-Version" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap"
                   Text="Windows 용 압축 관리자입니다. 압축파일을 열어 내용을 보고, 풀고, 테스트하고, 새로 만들거나 항목을 추가·삭제·이름 바꾸기 할 수 있습니다. 자세한 기능과 단축키는 도움말(HELP.md)에 있습니다." />
        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="제3자 구성요소 고지" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                   Text="SharpCompress 1.0.0 — MIT License (Copyright (c) 2014 Adam Hathcock). 압축 형식 처리에 사용합니다.&#10;System.Security.Cryptography.ProtectedData 9.0.10 — MIT License (Copyright (c) .NET Foundation and Contributors). Windows 데이터 보호(DPAPI) 호출에 사용합니다.&#10;전문은 프로그램 폴더의 THIRD-PARTY-NOTICES.txt 에 있습니다." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="확인" IsDefault="True" IsCancel="True" Style="{StaticResource Oz.Button}" />
        </StackPanel>
    </StackPanel>
</Window>
