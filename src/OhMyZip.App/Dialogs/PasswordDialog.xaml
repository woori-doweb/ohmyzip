<Window x:Class="OhMyZip.App.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
        Style="{StaticResource Oz.WindowStyle}"
        Title="{x:Static res:DialogText.Password_Title}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-PasswordDialog">
    <StackPanel Margin="20,18,20,16">
        <StackPanel Orientation="Horizontal">
            <!-- 아이콘 + 문장: 틀린 암호는 경고 아이콘과 문장으로 알린다. -->
            <TextBlock x:Name="MessageGlyph" FontFamily="{StaticResource Oz.IconFont}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Text="&#xE72E;" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="OZ-Password-Message" />
        </StackPanel>
        <TextBlock x:Name="ArchiveText" Margin="0,6,0,10" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}" />
        <TextBlock x:Name="PasswordLabel" Text="{x:Static res:DialogText.Password_Label}" Margin="0,0,0,4" />
        <Grid>
            <PasswordBox x:Name="Masked" MinHeight="32" VerticalContentAlignment="Center" Padding="6,0"
                         Background="{DynamicResource Oz.Background}" Foreground="{DynamicResource Oz.Text}" BorderBrush="{DynamicResource Oz.Border}" CaretBrush="{DynamicResource Oz.Text}"
                         AutomationProperties.Name="{x:Static res:DialogText.Password_Name}" AutomationProperties.AutomationId="OZ-Password-Box" />
            <TextBox x:Name="Plain" Style="{StaticResource Oz.TextBox}" Visibility="Collapsed"
                     AutomationProperties.Name="{x:Static res:DialogText.Password_PlainName}" AutomationProperties.AutomationId="OZ-Password-Plain" />
        </Grid>
        <CheckBox x:Name="ShowBox" Content="{x:Static res:DialogText.Password_Show}" Margin="0,8,0,0" Foreground="{DynamicResource Oz.Text}"
                  Checked="OnShowChanged" Unchecked="OnShowChanged" AutomationProperties.AutomationId="OZ-Password-Show" />
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{x:Static res:DialogText.Password_Manager_Button}" IsEnabled="False" Style="{StaticResource Oz.Button}" Margin="0"
                    ToolTip="{x:Static res:DialogText.Password_ManagerTip}" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.AutomationId="OZ-Password-Manager" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Cancel_Button}" IsCancel="True" Style="{StaticResource Oz.Button}" AutomationProperties.AutomationId="OZ-Password-Cancel" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Password_Ok_Button}" IsDefault="True" Style="{StaticResource Oz.Button}" Click="OnOk" AutomationProperties.AutomationId="OZ-Password-Ok" />
        </DockPanel>
    </StackPanel>
</Window>
