<Window x:Class="OhMyPic.App.Dialogs.FontListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        xmlns:local="clr-namespace:OhMyPic.App.Dialogs"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:FontText.Window_Title}" Width="760" Height="620" MinWidth="560" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static res:FontText.Window_Title}"
        AutomationProperties.AutomationId="OP-FontListWindow">
    <Window.Resources>
        <Style x:Key="Fonts.Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <!-- Favourite star: icon toggle, 32x32 DIP. Not a tab stop; Space on the selected row toggles it from the keyboard.
             The IsFavorite change itself is saved (any source); Click only selects the row. -->
        <Style x:Key="Fonts.Star" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Op.IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Content" Value="&#xE734;" />
            <Setter Property="ToolTip" Value="{x:Static res:FontText.Favorite_AddToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE735;" />
                    <Setter Property="ToolTip" Value="{x:Static res:FontText.Favorite_RemoveToolTip}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Fonts.RowTemplate" DataType="{x:Type local:FontRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource Fonts.Star}" VerticalAlignment="Top" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="OnStarClick"
                              AutomationProperties.Name="{Binding FavoriteName}" />
                <StackPanel Grid.Column="1" Margin="8,0,0,2">
                    <StackPanel Orientation="Horizontal" MinHeight="32">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FamilyName}" Visibility="{Binding FamilyNameVisibility}" FontSize="{StaticResource Op.SecondarySize}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SampleText" FontFamily="{Binding Family}" TextTrimming="CharacterEllipsis"
                               Text="{Binding PreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding PreviewSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Empty preview text: each font shows its own name. -->
                <DataTrigger Binding="{Binding PreviewText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                    <Setter TargetName="SampleText" Property="Text" Value="{Binding DisplayName}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search and filters -->
        <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchLabel" Style="{StaticResource Fonts.Label}" Text="{x:Static res:FontText.Search_Label}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Op.TextBox}"
                     AutomationProperties.Name="{x:Static res:FontText.Search_Name}" AutomationProperties.AutomationId="OP-Fonts-Search" />
            <CheckBox x:Name="HangulOnlyBox" Grid.Column="2" Content="{x:Static res:FontText.HangulOnly}"
                      AutomationProperties.Name="{x:Static res:FontText.HangulOnly}" AutomationProperties.AutomationId="OP-Fonts-HangulOnly" />
            <CheckBox x:Name="FavoritesOnlyBox" Grid.Column="3" Content="{x:Static res:FontText.FavoritesOnly}"
                      AutomationProperties.Name="{x:Static res:FontText.FavoritesOnly}" AutomationProperties.AutomationId="OP-Fonts-FavoritesOnly" />
        </Grid>

        <!-- Preview text and size -->
        <Grid Grid.Row="1" Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SampleLabel" Style="{StaticResource Fonts.Label}" Text="{x:Static res:FontText.Sample_Label}" />
            <TextBox x:Name="SampleBox" Grid.Column="1" Style="{StaticResource Op.TextBox}"
                     AutomationProperties.Name="{x:Static res:FontText.Sample_Label}" AutomationProperties.AutomationId="OP-Fonts-Sample" />
            <TextBlock Grid.Column="2" Style="{StaticResource Fonts.Label}" Margin="16,0,8,0" Text="{x:Static res:FontText.Size_Label}" />
            <Slider x:Name="SizeSlider" Grid.Column="3" Width="160" MinHeight="32" VerticalAlignment="Center"
                    Minimum="12" Maximum="72" SmallChange="1" LargeChange="6" TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="{x:Static res:FontText.Size_Name}" AutomationProperties.AutomationId="OP-Fonts-Size" />
            <TextBlock Grid.Column="4" MinWidth="28" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                       Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.HelpText="{x:Static res:FontText.Size_Name}" AutomationProperties.AutomationId="OP-Fonts-SizeValue" />
        </Grid>

        <!-- Font rows (virtualized: only visible rows create text in their font) -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <ListBox x:Name="FontList" IsEnabled="False" HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource Op.Background}" Foreground="{DynamicResource Op.Text}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1"
                     Padding="2" SelectionMode="Single" ItemTemplate="{StaticResource Fonts.RowTemplate}"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     TextSearch.TextPath="DisplayName"
                     AutomationProperties.Name="{x:Static res:FontText.List_Name}" AutomationProperties.AutomationId="OP-Fonts-List">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Op.EntryListItem}">
                        <Setter Property="Padding" Value="4,4,8,6" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding FavoriteStatus}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="24" Foreground="{DynamicResource Op.SecondaryText}" Text="{x:Static res:FontText.Empty}"
                       AutomationProperties.AutomationId="OP-Fonts-Empty" />
        </Grid>

        <StatusBar Grid.Row="3" Style="{StaticResource Op.StatusBar}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="CountText" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OP-Fonts-Count" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{x:Static res:FontText.KeysHint}" AutomationProperties.AutomationId="OP-Fonts-KeysHint" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
