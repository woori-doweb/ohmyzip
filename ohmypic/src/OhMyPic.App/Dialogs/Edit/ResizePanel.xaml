<UserControl x:Class="OhMyPic.App.Dialogs.Edit.ResizePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
             AutomationProperties.Name="{x:Static res:EditText.Resize_GroupLabel}"
             AutomationProperties.AutomationId="OP-Edit-Resize">
    <StackPanel>
        <TextBlock Text="{x:Static res:EditText.Resize_GroupLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />

        <!-- By percentage -->
        <DockPanel>
            <RadioButton x:Name="PercentRadio" GroupName="OpEditResizeMode" Content="{x:Static res:EditText.Resize_ByRatio}" Foreground="{DynamicResource Op.Text}"
                         Width="200" MinHeight="32" VerticalContentAlignment="Center" Checked="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Resize_ByRatio}" AutomationProperties.AutomationId="OP-Edit-Resize-ByRatio" />
            <TextBox x:Name="PercentBox" Style="{StaticResource Op.TextBox}" Width="80" HorizontalContentAlignment="Right" TextChanged="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Resize_PercentName}" AutomationProperties.AutomationId="OP-Edit-Resize-Percent" />
            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
        </DockPanel>
        <TextBlock x:Name="PercentError" Margin="200,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Resize-PercentError" />

        <!-- By width and height -->
        <DockPanel Margin="0,8,0,0">
            <RadioButton x:Name="PixelsRadio" GroupName="OpEditResizeMode" Content="{x:Static res:EditText.Resize_ByResolution}" Foreground="{DynamicResource Op.Text}"
                         Width="200" MinHeight="32" VerticalContentAlignment="Center" Checked="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Resize_ByResolution}" AutomationProperties.AutomationId="OP-Edit-Resize-ByResolution" />
            <TextBox x:Name="WidthBox" Style="{StaticResource Op.TextBox}" Width="80" HorizontalContentAlignment="Right" TextChanged="OnWidthChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Resize_WidthName}" AutomationProperties.AutomationId="OP-Edit-Resize-Width" />
            <TextBlock Text="&#x00D7;" VerticalAlignment="Center" Margin="6,0" />
            <TextBox x:Name="HeightBox" Style="{StaticResource Op.TextBox}" Width="80" HorizontalContentAlignment="Right" TextChanged="OnHeightChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Resize_HeightName}" AutomationProperties.AutomationId="OP-Edit-Resize-Height" />
            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
        </DockPanel>
        <CheckBox x:Name="KeepAspectBox" Content="{x:Static res:EditText.Resize_KeepAspect}" Margin="200,6,0,0" Foreground="{DynamicResource Op.Text}"
                  MinHeight="24" VerticalContentAlignment="Center" Checked="OnKeepAspectChanged" Unchecked="OnKeepAspectChanged"
                  AutomationProperties.Name="{x:Static res:EditText.Resize_KeepAspect}" AutomationProperties.AutomationId="OP-Edit-Resize-KeepAspect" />
        <TextBlock x:Name="PixelsError" Margin="200,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Resize-PixelsError" />

        <!-- By long side -->
        <DockPanel Margin="0,8,0,0">
            <RadioButton x:Name="LongAxisRadio" GroupName="OpEditResizeMode" Content="{x:Static res:EditText.Resize_ByAxis}" Foreground="{DynamicResource Op.Text}"
                         Width="200" MinHeight="32" VerticalContentAlignment="Center" Checked="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Resize_ByAxis}" AutomationProperties.AutomationId="OP-Edit-Resize-ByAxis" />
            <TextBox x:Name="LongAxisBox" Style="{StaticResource Op.TextBox}" Width="80" HorizontalContentAlignment="Right" TextChanged="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Resize_LongSideName}" AutomationProperties.AutomationId="OP-Edit-Resize-LongAxis" />
            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
        </DockPanel>
        <TextBlock x:Name="LongAxisError" Margin="200,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Resize-LongAxisError" />

        <!-- By file size -->
        <DockPanel Margin="0,8,0,0">
            <RadioButton x:Name="FileSizeRadio" GroupName="OpEditResizeMode" Content="{x:Static res:EditText.Resize_BySize}" Foreground="{DynamicResource Op.Text}"
                         Width="200" MinHeight="32" VerticalContentAlignment="Center" Checked="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Resize_BySize}" AutomationProperties.AutomationId="OP-Edit-Resize-BySize" />
            <TextBox x:Name="FileSizeBox" Style="{StaticResource Op.TextBox}" Width="80" HorizontalContentAlignment="Right" TextChanged="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Resize_TargetSizeName}" AutomationProperties.AutomationId="OP-Edit-Resize-TargetSize" />
            <TextBlock Text="KB" VerticalAlignment="Center" Margin="6,0,0,0" />
        </DockPanel>
        <TextBlock x:Name="FileSizeNote" Text="{x:Static res:EditText.Resize_TargetSizeNote}" Margin="200,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Edit-Resize-TargetSizeNote" />
        <TextBlock x:Name="FileSizeError" Margin="200,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Resize-TargetSizeError" />

        <!-- Result preview for the first file -->
        <TextBlock Text="{x:Static res:EditText.Preview_Label}" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="{DynamicResource Op.Text}"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.AutomationId="OP-Edit-Resize-Preview" />
    </StackPanel>
</UserControl>
