<UserControl x:Class="OhMyPic.App.Dialogs.Edit.ConvertPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
             AutomationProperties.Name="{x:Static res:EditText.Convert_GroupLabel}"
             AutomationProperties.AutomationId="OP-Edit-Convert">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="FormatLabel" Text="{x:Static res:EditText.Convert_FormatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" MinHeight="32" Width="140" HorizontalAlignment="Left" SelectionChanged="OnFormatChanged"
                      AutomationProperties.Name="{x:Static res:EditText.Convert_FormatLabel}" AutomationProperties.AutomationId="targetFormatComboBox" />

            <TextBlock x:Name="BppLabel" Grid.Row="1" Text="{x:Static res:EditText.Convert_BppLabel}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <ComboBox x:Name="BppBox" MinHeight="32" Width="140" IsEnabled="False"
                          ToolTip="{x:Static res:EditText.Convert_BppHelp}" ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="{x:Static res:EditText.Convert_BppLabel}" AutomationProperties.HelpText="{x:Static res:EditText.Convert_BppHelp}"
                          AutomationProperties.AutomationId="bitPerPixelComboBox" />
                <TextBlock Text="{x:Static res:EditText.Convert_BppHelp}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="260"
                           Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
            </StackPanel>

            <TextBlock x:Name="QualityLabel" Grid.Row="2" Text="{x:Static res:EditText.Convert_QualityLabel}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                <TextBox x:Name="QualityBox" DockPanel.Dock="Right" Style="{StaticResource Op.TextBox}" Width="64" Margin="10,0,0,0" HorizontalContentAlignment="Right"
                         TextChanged="OnQualityTextChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Convert_QualityValueName}" AutomationProperties.AutomationId="OP-Edit-Convert-QualityValue" />
                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" MinHeight="32" ValueChanged="OnQualitySliderChanged"
                        AutomationProperties.Name="{x:Static res:EditText.Convert_QualityLabel}" AutomationProperties.AutomationId="OP-Edit-Convert-Quality" />
            </DockPanel>
            <TextBlock x:Name="QualityNote" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Edit-Convert-QualityNote" />
            <TextBlock x:Name="QualityError" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Convert-QualityError" />
        </Grid>

        <!-- Multiple frames (animated GIF, multi-page TIFF) -->
        <TextBlock Text="{x:Static res:EditText.Convert_FramesLabel}" FontWeight="SemiBold" Margin="0,14,0,6" />
        <RadioButton x:Name="FirstFrameRadio" GroupName="OpEditConvertFrames" Content="{x:Static res:EditText.Convert_FirstFrame}" Foreground="{DynamicResource Op.Text}"
                     MinHeight="24" VerticalContentAlignment="Center" Checked="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Convert_FirstFrame}" AutomationProperties.AutomationId="OP-Edit-Convert-FirstFrame" />
        <RadioButton x:Name="AllFramesRadio" GroupName="OpEditConvertFrames" Content="{x:Static res:EditText.Convert_AllFrames}" Foreground="{DynamicResource Op.Text}" Margin="0,4,0,0"
                     MinHeight="24" VerticalContentAlignment="Center" Checked="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Convert_AllFrames}" AutomationProperties.AutomationId="OP-Edit-Convert-AllFrames" />
        <RadioButton x:Name="SplitFramesRadio" GroupName="OpEditConvertFrameSplit" Content="{x:Static res:EditText.Convert_SplitFrames}" Foreground="{DynamicResource Op.Text}" Margin="24,4,0,0"
                     MinHeight="24" VerticalContentAlignment="Center" Checked="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Convert_SplitFrames}" AutomationProperties.AutomationId="OP-Edit-Convert-SplitFrames" />
        <RadioButton x:Name="CombineFramesRadio" GroupName="OpEditConvertFrameSplit" Content="{x:Static res:EditText.Convert_CombineFrames}" Foreground="{DynamicResource Op.Text}" Margin="24,4,0,0"
                     MinHeight="24" VerticalContentAlignment="Center" Checked="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Convert_CombineFrames}" AutomationProperties.AutomationId="OP-Edit-Convert-CombineFrames" />
    </StackPanel>
</UserControl>
