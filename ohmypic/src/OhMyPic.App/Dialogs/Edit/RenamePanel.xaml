<UserControl x:Class="OhMyPic.App.Dialogs.Edit.RenamePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
             AutomationProperties.Name="{x:Static res:EditText.Rename_GroupLabel}"
             AutomationProperties.AutomationId="OP-Edit-Rename">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static res:EditText.Rename_TemplateLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="TemplateBox" Grid.Column="1" Style="{StaticResource Op.TextBox}" TextChanged="OnInputChanged"
                     AutomationProperties.Name="{x:Static res:EditText.Rename_TemplateLabel}" AutomationProperties.HelpText="{x:Static res:EditText.Rename_TokenHelp}"
                     AutomationProperties.AutomationId="OP-Edit-Rename-Template" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:EditText.Rename_TokenHelp}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Edit-Rename-TokenHelp" />

            <TextBlock Grid.Row="2" Text="{x:Static res:EditText.Rename_StartLabel}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="StartBox" Style="{StaticResource Op.TextBox}" Width="90" HorizontalContentAlignment="Right" TextChanged="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Rename_StartLabel}" AutomationProperties.AutomationId="OP-Edit-Rename-Start" />
                <TextBlock Text="{x:Static res:EditText.Rename_DigitsLabel}" VerticalAlignment="Center" Margin="18,0,12,0" />
                <TextBox x:Name="DigitsBox" Style="{StaticResource Op.TextBox}" Width="60" HorizontalContentAlignment="Right" TextChanged="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Rename_DigitsLabel}" AutomationProperties.HelpText="{x:Static res:EditText.Rename_DigitsHelp}"
                         AutomationProperties.AutomationId="OP-Edit-Rename-Digits" />
                <TextBlock Text="{x:Static res:EditText.Rename_DigitsHelp}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
            </StackPanel>
            <TextBlock x:Name="NumberError" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Rename-NumberError" />

            <TextBlock Grid.Row="4" Text="{x:Static res:EditText.Rename_CaseLabel}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <ComboBox x:Name="CaseBox" Grid.Row="4" Grid.Column="1" MinHeight="32" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="OnInputChanged"
                      AutomationProperties.Name="{x:Static res:EditText.Rename_CaseLabel}" AutomationProperties.AutomationId="OP-Edit-Rename-Case" />

            <TextBlock Grid.Row="5" Text="{x:Static res:EditText.Rename_FindLabel}" VerticalAlignment="Center" Margin="0,8,12,0" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FindBox" Style="{StaticResource Op.TextBox}" TextChanged="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Rename_FindLabel}" AutomationProperties.AutomationId="OP-Edit-Rename-Find" />
                <TextBlock Grid.Column="1" Text="{x:Static res:EditText.Rename_ReplaceLabel}" VerticalAlignment="Center" Margin="12,0" />
                <TextBox x:Name="ReplaceBox" Grid.Column="2" Style="{StaticResource Op.TextBox}" TextChanged="OnInputChanged"
                         AutomationProperties.Name="{x:Static res:EditText.Rename_ReplaceLabel}" AutomationProperties.AutomationId="OP-Edit-Rename-Replace" />
            </Grid>

            <TextBlock x:Name="TemplateError" Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Edit-Rename-TemplateError" />
        </Grid>

        <TextBlock Text="{x:Static res:EditText.Rename_SampleLabel}" FontWeight="SemiBold" Margin="0,14,0,4" />
        <ItemsControl x:Name="SampleList" Focusable="False"
                      AutomationProperties.Name="{x:Static res:EditText.Rename_SampleLabel}" AutomationProperties.AutomationId="OP-Edit-Rename-Sample">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,1" Foreground="{DynamicResource Op.Text}"
                               AutomationProperties.Name="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
