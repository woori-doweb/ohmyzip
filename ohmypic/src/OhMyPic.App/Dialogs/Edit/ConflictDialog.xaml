<Window x:Class="OhMyPic.App.Dialogs.Edit.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:EditText.Conflict_Title}" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static res:EditText.Conflict_Title}"
        AutomationProperties.AutomationId="OP-ConflictDialog">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="OP-Conflict-Heading" />
        <TextBlock x:Name="FolderText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   AutomationProperties.AutomationId="OP-Conflict-Folder" />
        <TextBlock x:Name="SourceText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   AutomationProperties.AutomationId="OP-Conflict-Source" />
        <CheckBox x:Name="ApplyAllBox" Content="{x:Static res:EditText.Conflict_ApplyAll}" Margin="0,14,0,0" Foreground="{DynamicResource Op.Text}"
                  MinHeight="24" VerticalContentAlignment="Center"
                  AutomationProperties.Name="{x:Static res:EditText.Conflict_ApplyAll}" AutomationProperties.AutomationId="OP-Conflict-ApplyAll" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:EditText.Conflict_Overwrite}" Style="{StaticResource Op.Button}" Click="OnOverwrite"
                    AutomationProperties.Name="{x:Static res:EditText.Conflict_Overwrite}" AutomationProperties.AutomationId="OP-Conflict-Overwrite" />
            <Button x:Name="KeepBothButton" Content="{x:Static res:EditText.Conflict_KeepBoth}" IsDefault="True" Style="{StaticResource Op.Button}" Click="OnKeepBoth"
                    AutomationProperties.Name="{x:Static res:EditText.Conflict_KeepBoth}" AutomationProperties.AutomationId="OP-Conflict-KeepBoth" />
            <Button Content="{x:Static res:EditText.Conflict_Skip}" IsCancel="True" Style="{StaticResource Op.Button}"
                    AutomationProperties.Name="{x:Static res:EditText.Conflict_Skip}" AutomationProperties.AutomationId="OP-Conflict-Skip" />
        </StackPanel>
    </StackPanel>
</Window>
