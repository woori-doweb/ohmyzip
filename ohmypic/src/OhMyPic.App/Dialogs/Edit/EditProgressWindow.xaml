<Window x:Class="OhMyPic.App.Dialogs.Edit.EditProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OP-EditProgressWindow">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" AutomationProperties.AutomationId="OP-EditProgress-Heading" />
        <TextBlock x:Name="CurrentText" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Op.SecondaryText}"
                   FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.Name="{x:Static res:EditText.Progress_CurrentName}"
                   AutomationProperties.AutomationId="OP-EditProgress-Current" />
        <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1"
                     Foreground="{DynamicResource Op.Accent}" Background="{DynamicResource Op.Hover}" BorderThickness="0"
                     AutomationProperties.Name="{x:Static res:EditText.Progress_BarName}" AutomationProperties.AutomationId="OP-EditProgress-Bar" />
        <TextBlock x:Name="CountText" Margin="0,6,0,0" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   AutomationProperties.Name="{x:Static res:EditText.Progress_CountName}" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="OP-EditProgress-Count" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{x:Static res:EditText.Cancel_Button}" IsCancel="True" Style="{StaticResource Op.Button}" Click="OnCancel"
                    AutomationProperties.Name="{x:Static res:EditText.Cancel_Button}" AutomationProperties.AutomationId="OP-EditProgress-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
