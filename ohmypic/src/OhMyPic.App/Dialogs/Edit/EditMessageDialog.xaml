<Window x:Class="OhMyPic.App.Dialogs.Edit.EditMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OP-EditMessageDialog">
    <Grid Margin="20,20,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon plus words: meaning is never carried by colour alone. -->
        <TextBlock x:Name="IconGlyph" Grid.RowSpan="2" FontFamily="{StaticResource Op.IconFont}" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Top"
                   AutomationProperties.AutomationId="OP-EditMessage-Icon" />
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="OP-EditMessage-Heading" />
            <TextBlock x:Name="BodyText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Text}" AutomationProperties.AutomationId="OP-EditMessage-Body" />
        </StackPanel>

        <ListBox x:Name="ProblemList" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" MaxHeight="240" MinWidth="320"
                 Background="{DynamicResource Op.Background}" Foreground="{DynamicResource Op.Text}" BorderBrush="{DynamicResource Op.Border}"
                 AutomationProperties.Name="{x:Static res:EditText.Message_ProblemsName}" AutomationProperties.AutomationId="OP-EditMessage-Details" Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <StackPanel x:Name="ButtonPanel" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
