<Window x:Class="OhMyPic.App.Dialogs.Edit.ConvertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        xmlns:edit="clr-namespace:OhMyPic.App.Dialogs.Edit"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:EditText.Convert_Title}" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static res:EditText.Convert_Title}"
        AutomationProperties.AutomationId="OP-ConvertDialog">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"
                   AutomationProperties.AutomationId="OP-Convert-Heading" />
        <edit:ConvertPanel x:Name="OptionsPanel" />

        <TextBlock Text="{x:Static res:EditText.Convert_FilesLabel}" FontWeight="SemiBold" Margin="0,14,0,6" />
        <Border BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="FileTable" Style="{StaticResource Op.DataGrid}" Height="140" SelectionMode="Single" HeadersVisibility="Column"
                      AutomationProperties.Name="{x:Static res:EditText.Convert_FilesLabel}" AutomationProperties.AutomationId="OP-Convert-Files">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:EditText.Convert_SourceColumn}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{x:Static res:EditText.Convert_TargetColumn}" Binding="{Binding TargetName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Height="1" Background="{DynamicResource Op.Border}" Margin="0,16" />
        <edit:OutputOptionsControl x:Name="OutputPanel" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConfirmButton" Content="{x:Static res:EditText.Convert_Button}" IsDefault="True" Style="{StaticResource Op.Button}" Click="OnConfirm"
                    AutomationProperties.Name="{x:Static res:EditText.Convert_Button}" AutomationProperties.AutomationId="OP-Convert-Confirm" />
            <Button Content="{x:Static res:EditText.Cancel_Button}" IsCancel="True" Style="{StaticResource Op.Button}"
                    AutomationProperties.Name="{x:Static res:EditText.Cancel_Button}" AutomationProperties.AutomationId="OP-Convert-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
