<Window x:Class="OhMyPic.App.Dialogs.Edit.BatchEditWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        xmlns:edit="clr-namespace:OhMyPic.App.Dialogs.Edit"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:EditText.Batch_Title}" Width="680" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown"
        AutomationProperties.Name="{x:Static res:EditText.Batch_Title}"
        AutomationProperties.AutomationId="OP-BatchEditWizard">
    <StackPanel Margin="20,18,20,16">
        <!-- Step strip: current step is bold + marked, skipped steps are dimmed and say so in their accessible name. -->
        <StackPanel x:Name="StepStrip" Orientation="Horizontal" Margin="0,0,0,10" AutomationProperties.Name="{x:Static res:EditText.Batch_StepsName}"
                    AutomationProperties.AutomationId="OP-Batch-Steps">
            <TextBlock x:Name="Step1Text" Text="{x:Static res:EditText.Batch_Step1}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Batch-Step1" />
            <TextBlock Text="&#x203A;" Margin="8,0" FontSize="{StaticResource Op.SecondarySize}" Foreground="{DynamicResource Op.SecondaryText}" />
            <TextBlock x:Name="Step2Text" Text="{x:Static res:EditText.Batch_Step2}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Batch-Step2" />
            <TextBlock Text="&#x203A;" Margin="8,0" FontSize="{StaticResource Op.SecondarySize}" Foreground="{DynamicResource Op.SecondaryText}" />
            <TextBlock x:Name="Step3Text" Text="{x:Static res:EditText.Batch_Step3}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Batch-Step3" />
            <TextBlock Text="&#x203A;" Margin="8,0" FontSize="{StaticResource Op.SecondarySize}" Foreground="{DynamicResource Op.SecondaryText}" />
            <TextBlock x:Name="Step4Text" Text="{x:Static res:EditText.Batch_Step4}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Batch-Step4" />
            <TextBlock Text="&#x203A;" Margin="8,0" FontSize="{StaticResource Op.SecondarySize}" Foreground="{DynamicResource Op.SecondaryText}" />
            <TextBlock x:Name="Step5Text" Text="{x:Static res:EditText.Batch_Step5}" FontSize="{StaticResource Op.SecondarySize}" AutomationProperties.AutomationId="OP-Batch-Step5" />
        </StackPanel>
        <TextBlock x:Name="StepCountText" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OP-Batch-StepCount" />
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,12" AutomationProperties.AutomationId="OP-Batch-Heading" />

        <Grid MinHeight="420">
            <!-- 1. Select tasks -->
            <StackPanel x:Name="SelectPage" AutomationProperties.Name="{x:Static res:EditText.Batch_Step1}" AutomationProperties.AutomationId="OP-Batch-SelectPage">
                <TextBlock Text="{x:Static res:EditText.Batch_SelectIntro1}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:EditText.Batch_SelectIntro2}" TextWrapping="Wrap" Margin="0,2,0,10"
                           Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />

                <Border BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="ResizeTaskBox" Content="{x:Static res:EditText.Batch_TaskResize}" FontWeight="SemiBold" Foreground="{DynamicResource Op.Text}"
                                  MinHeight="24" VerticalContentAlignment="Center" Checked="OnTaskChanged" Unchecked="OnTaskChanged"
                                  AutomationProperties.Name="{x:Static res:EditText.Batch_TaskResize}" AutomationProperties.HelpText="{x:Static res:EditText.Batch_TaskResizeDescription}"
                                  AutomationProperties.AutomationId="resizePageCheckBox" />
                        <TextBlock Text="{x:Static res:EditText.Batch_TaskResizeDescription}" Margin="20,0,0,0" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="RotateTaskBox" Content="{x:Static res:EditText.Batch_TaskRotate}" FontWeight="SemiBold" Foreground="{DynamicResource Op.Text}"
                                  MinHeight="24" VerticalContentAlignment="Center" Checked="OnTaskChanged" Unchecked="OnTaskChanged"
                                  AutomationProperties.Name="{x:Static res:EditText.Batch_TaskRotate}" AutomationProperties.HelpText="{x:Static res:EditText.Batch_TaskRotateDescription}"
                                  AutomationProperties.AutomationId="rotatePageCheckBox" />
                        <TextBlock Text="{x:Static res:EditText.Batch_TaskRotateDescription}" Margin="20,0,0,0" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="RenameTaskBox" Content="{x:Static res:EditText.Batch_TaskRename}" FontWeight="SemiBold" Foreground="{DynamicResource Op.Text}"
                                  MinHeight="24" VerticalContentAlignment="Center" Checked="OnTaskChanged" Unchecked="OnTaskChanged"
                                  AutomationProperties.Name="{x:Static res:EditText.Batch_TaskRename}" AutomationProperties.HelpText="{x:Static res:EditText.Batch_TaskRenameDescription}"
                                  AutomationProperties.AutomationId="renamePageCheckBox" />
                        <TextBlock Text="{x:Static res:EditText.Batch_TaskRenameDescription}" Margin="20,0,0,0" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="ConvertTaskBox" Content="{x:Static res:EditText.Batch_TaskConvert}" FontWeight="SemiBold" Foreground="{DynamicResource Op.Text}"
                                  MinHeight="24" VerticalContentAlignment="Center" Checked="OnTaskChanged" Unchecked="OnTaskChanged"
                                  AutomationProperties.Name="{x:Static res:EditText.Batch_TaskConvert}" AutomationProperties.HelpText="{x:Static res:EditText.Batch_TaskConvertDescription}"
                                  AutomationProperties.AutomationId="convertPageCheckBox" />
                        <TextBlock Text="{x:Static res:EditText.Batch_TaskConvertDescription}" Margin="20,0,0,0" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TaskError" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Batch-TaskError" />

                <DockPanel Margin="0,10,0,4">
                    <Button x:Name="RemoveFilesButton" DockPanel.Dock="Right" Content="{x:Static res:EditText.Batch_RemoveFiles}" Style="{StaticResource Op.Button}" Click="OnRemoveFiles"
                            AutomationProperties.Name="{x:Static res:EditText.Batch_RemoveFiles}" AutomationProperties.AutomationId="OP-Batch-RemoveFiles" />
                    <Button DockPanel.Dock="Right" Content="{x:Static res:EditText.Batch_AddFiles}" Style="{StaticResource Op.Button}" Click="OnAddFiles"
                            AutomationProperties.Name="{x:Static res:EditText.Batch_AddFiles}" AutomationProperties.AutomationId="OP-Batch-AddFiles" />
                    <TextBlock x:Name="FilesLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <ListBox x:Name="FileList" Height="110" SelectionMode="Extended" SelectionChanged="OnFileSelectionChanged" KeyDown="OnFileListKeyDown"
                         Background="{DynamicResource Op.Background}" Foreground="{DynamicResource Op.Text}" BorderBrush="{DynamicResource Op.Border}"
                         ItemContainerStyle="{StaticResource Op.EntryListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{x:Static res:EditText.Batch_FilesName}" AutomationProperties.AutomationId="OP-Batch-Files">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FilesError" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="OP-Batch-FilesError" />
            </StackPanel>

            <!-- 2. Resize -->
            <edit:ResizePanel x:Name="ResizeStep" Visibility="Collapsed" />

            <!-- 3. Rotate -->
            <edit:RotatePanel x:Name="RotateStep" Visibility="Collapsed" />

            <!-- 4. Rename -->
            <edit:RenamePanel x:Name="RenameStep" Visibility="Collapsed" />

            <!-- 5. Convert and save -->
            <StackPanel x:Name="SavePage" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:EditText.Batch_Step5}" AutomationProperties.AutomationId="OP-Batch-SavePage">
                <edit:ConvertPanel x:Name="ConvertStep" />
                <TextBlock x:Name="KeepFormatNote" Text="{x:Static res:EditText.Batch_KeepFormatNote}" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Op.SecondaryText}" AutomationProperties.AutomationId="OP-Batch-KeepFormatNote" />
                <Border Height="1" Background="{DynamicResource Op.Border}" Margin="0,14" />
                <edit:OutputOptionsControl x:Name="OutputStep" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BackButton" Content="{x:Static res:EditText.Batch_Back}" Style="{StaticResource Op.Button}" Click="OnBack"
                    AutomationProperties.Name="{x:Static res:EditText.Batch_Back}" AutomationProperties.AutomationId="OP-Batch-Back" />
            <Button x:Name="NextButton" Content="{x:Static res:EditText.Batch_Next}" IsDefault="True" Style="{StaticResource Op.Button}" Click="OnNext"
                    AutomationProperties.AutomationId="OP-Batch-Next" />
            <Button Content="{x:Static res:EditText.Cancel_Button}" Style="{StaticResource Op.Button}" Click="OnCancel"
                    AutomationProperties.Name="{x:Static res:EditText.Cancel_Button}" AutomationProperties.AutomationId="OP-Batch-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
