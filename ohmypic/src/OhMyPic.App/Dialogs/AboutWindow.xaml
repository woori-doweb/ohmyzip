<Window x:Class="OhMyPic.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:DialogText.About_Title}" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OP-AboutWindow">
    <StackPanel Margin="24,22,24,18">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource Op.AppIcon}" Width="56" Height="56" AutomationProperties.Name="{x:Static res:DialogText.About_LogoName}" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:DialogText.App_Name}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                           AutomationProperties.AutomationId="OP-About-Version" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="{x:Static res:DialogText.About_Description}" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   Text="{x:Static res:DialogText.About_Formats}" />
        <TextBlock x:Name="FormatsText" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   AutomationProperties.AutomationId="OP-About-Formats" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.SecondaryText}" FontSize="{StaticResource Op.SecondarySize}"
                   Text="{x:Static res:DialogText.About_Notices}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:DialogText.Ok_Button}" IsDefault="True" IsCancel="True" Style="{StaticResource Op.Button}"
                    AutomationProperties.AutomationId="OP-About-Ok" />
        </StackPanel>
    </StackPanel>
</Window>
