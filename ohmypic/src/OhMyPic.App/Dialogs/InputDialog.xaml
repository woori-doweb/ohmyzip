<Window x:Class="OhMyPic.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OP-InputDialog">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValueBox" Style="{StaticResource Op.TextBox}" AutomationProperties.LabeledBy="{Binding ElementName=PromptText}"
                     AutomationProperties.AutomationId="OP-Input-Value" />
            <TextBlock x:Name="SuffixText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Op.SecondaryText}"
                       AutomationProperties.AutomationId="OP-Input-Suffix" />
        </Grid>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Op.Error}" Visibility="Collapsed"
                   AutomationProperties.AutomationId="OP-Input-Error" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="{x:Static res:DialogText.Ok_Button}" IsDefault="True" Style="{StaticResource Op.Button}" Click="OnOk"
                    AutomationProperties.AutomationId="OP-Input-Ok" />
            <Button Content="{x:Static res:DialogText.Cancel_Button}" IsCancel="True" Style="{StaticResource Op.Button}"
                    AutomationProperties.AutomationId="OP-Input-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
