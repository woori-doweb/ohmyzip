<Window x:Class="OhMyPic.App.Editor.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:EditorText.Export_Title}" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static res:EditorText.Export_Title}"
        AutomationProperties.AutomationId="OP-ExportDialog">
    <Window.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Export.Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,18,20,16">
        <Grid x:Name="OptionsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static res:EditorText.Export_FormatLabel}" Style="{StaticResource Export.Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="PngRadio" GroupName="Format" Content="{x:Static res:EditorText.Export_FormatPng}" Checked="OnOptionChanged"
                             AutomationProperties.Name="{x:Static res:EditorText.Export_FormatPng}" AutomationProperties.AutomationId="OP-Export-Format-Png" />
                <RadioButton x:Name="JpegRadio" GroupName="Format" Content="{x:Static res:EditorText.Export_FormatJpeg}" Checked="OnOptionChanged"
                             AutomationProperties.Name="{x:Static res:EditorText.Export_FormatJpeg}" AutomationProperties.AutomationId="OP-Export-Format-Jpeg" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{x:Static res:EditorText.Export_QualityLabel}" Style="{StaticResource Export.Label}" Margin="0,8,12,0" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" MinWidth="32" Margin="10,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                           AutomationProperties.HelpText="{x:Static res:EditorText.Export_QualityValueName}" AutomationProperties.AutomationId="OP-Export-QualityValue" />
                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" MinHeight="32" ValueChanged="OnQualityChanged"
                        AutomationProperties.Name="{x:Static res:EditorText.Export_QualityLabel}" AutomationProperties.AutomationId="OP-Export-Quality" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{x:Static res:EditorText.Export_ScaleLabel}" Style="{StaticResource Export.Label}" Margin="0,8,12,0" />
            <StackPanel x:Name="ScalePanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0" />

            <TextBlock Grid.Row="3" Text="{x:Static res:EditorText.Export_FinalSizeLabel}" Style="{StaticResource Export.Label}" Margin="0,12,12,0" />
            <TextBlock x:Name="FinalSizeText" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0"
                       AutomationProperties.HelpText="{x:Static res:EditorText.Export_FinalSizeLabel}" AutomationProperties.AutomationId="OP-Export-FinalSize" />

            <TextBlock Grid.Row="4" Text="{x:Static res:EditorText.Export_EstimateLabel}" Style="{StaticResource Export.Label}" Margin="0,8,12,0" />
            <TextBlock x:Name="EstimateText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.HelpText="{x:Static res:EditorText.Export_EstimateLabel}" AutomationProperties.AutomationId="OP-Export-Estimate" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="{x:Static res:EditorText.Export_Save}" IsDefault="True" Style="{StaticResource Op.Button}" Click="OnSave"
                    AutomationProperties.Name="{x:Static res:EditorText.Export_Save}" AutomationProperties.AutomationId="OP-Export-Save" />
            <Button x:Name="CancelButton" Content="{x:Static res:DialogText.Cancel_Button}" IsCancel="True" Style="{StaticResource Op.Button}"
                    AutomationProperties.Name="{x:Static res:DialogText.Cancel_Button}" AutomationProperties.AutomationId="OP-Export-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
