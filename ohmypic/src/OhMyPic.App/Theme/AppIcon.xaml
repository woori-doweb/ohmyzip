<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ohMypic icon master (64x64 grid): a rounded photo card with a small mountain and sun, and the words "oh my!"
        drawn as hand-lettered strokes. Used by the About window and by the executable icon (ohMypic.ico, generated by
        packaging/make_icon.ps1). Colours are fixed so the icon looks the same on any background.
        At 32 px and below (ico 16/20/24/32) Op.AppIconSmall is used: the same card and photo without the lettering.
    -->
    <DrawingImage x:Key="Op.AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Transparent square that fixes the drawing bounds -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />

                <!-- Card -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="5,4,54,56" RadiusX="9" RadiusY="9" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1E5AA8" Thickness="2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Photo: sky, sun, mountain (clipped to the rounded photo area) -->
                <DrawingGroup>
                    <DrawingGroup.ClipGeometry>
                        <RectangleGeometry Rect="10,9,44,30" RadiusX="5" RadiusY="5" />
                    </DrawingGroup.ClipGeometry>
                    <GeometryDrawing Geometry="M10,9 H54 V39 H10 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5CB6F2" Offset="0" />
                                <GradientStop Color="#CDEBFF" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFC531">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="43,18" RadiusX="5" RadiusY="5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2E9D6A" Geometry="M10,39 L23,22 L31,31 L37,25 L54,39 Z" />
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M23,22 L27,26.5 L25,25.5 L23,27 L21,25.5 L19.6,26.5 Z" />
                    <GeometryDrawing Brush="#237A52" Geometry="M10,39 V36 Q22,31 32,35.5 Q43,40 54,34.5 V39 Z" />
                </DrawingGroup>

                <!-- "oh my!" lettering -->
                <GeometryDrawing Geometry="M23.1,44 V54 M23.1,50.8 Q23.1,48.5 25.35,48.5 Q27.6,48.5 27.6,50.8 V54 M31.8,48.5 V54 M31.8,50.6 Q31.8,48.5 33.55,48.5 Q35.3,48.5 35.3,50.6 V54 M35.3,50.6 Q35.3,48.5 37.05,48.5 Q38.8,48.5 38.8,50.6 V54 M41.2,48.5 L43.8,53.6 M46,48.5 L42.4,57 M48.6,44 V50.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1E3A6E" Thickness="2.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="18,51.25" RadiusX="2.5" RadiusY="2.75" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1E3A6E" Thickness="2.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1E3A6E">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="48.6,53.6" RadiusX="1.4" RadiusY="1.4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Simplified version for 32 px and below (64x64 grid). Strokes and gaps are at least 3 units so they stay visible at 16 px. -->
    <DrawingImage x:Key="Op.AppIconSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,4,56,56" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1E5AA8" Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.ClipGeometry>
                        <RectangleGeometry Rect="11,11,42,42" RadiusX="6" RadiusY="6" />
                    </DrawingGroup.ClipGeometry>
                    <GeometryDrawing Brush="#5CB6F2" Geometry="M11,11 H53 V53 H11 Z" />
                    <GeometryDrawing Brush="#FFC531">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="41,23" RadiusX="6" RadiusY="6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2E9D6A" Geometry="M11,53 L26,31 L36,43 L42,37 L53,53 Z" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
