<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ohMypic icon master (64x64 grid), a sibling of the ohmyZip icon: the same soft pouch body and surprised
        "oh my!" face, in sky blue, with a small photo (sun and mountains) in a white frame on its forehead instead of
        the zipper. Used by the About window and by the executable icon (ohMypic.ico, generated by
        packaging/make_icon.ps1). Colours are fixed so the icon looks the same on any background.
        At 32 px and below (ico 16/20/24/32) Op.AppIconSmall is used: the same body, photo and face without the
        small details.
    -->
    <DrawingImage x:Key="Op.AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Transparent square that fixes the drawing bounds -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />

                <!-- Body: soft pouch, slightly wider at the bottom (same outline as the ohmyZip icon) -->
                <GeometryDrawing Geometry="M18,7 H46 C54,7 58,11 58.5,19 L60,44 C60.5,53 55,58.5 46,58.5 H18 C9,58.5 3.5,53 4,44 L5.5,19 C6,11 10,7 18,7 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C4ECFF" Offset="0" />
                            <GradientStop Color="#7CC6F7" Offset="0.55" />
                            <GradientStop Color="#4A97E8" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2F6FC4" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Photo frame on the forehead, slightly tilted like a stuck-on snapshot -->
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <RotateTransform Angle="-4" CenterX="32" CenterY="18" />
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="12,9.5,40,18" RadiusX="2.5" RadiusY="2.5" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2F6FC4" Thickness="1.4" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <DrawingGroup>
                        <DrawingGroup.ClipGeometry>
                            <RectangleGeometry Rect="14.5,12,35,13" RadiusX="1.5" RadiusY="1.5" />
                        </DrawingGroup.ClipGeometry>
                        <!-- Warm sky, sun, two mountains -->
                        <GeometryDrawing Geometry="M14.5,12 H49.5 V25 H14.5 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFE7A0" Offset="0" />
                                    <GradientStop Color="#FFF6DC" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF9A3D">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="43.5,16.5" RadiusX="2.8" RadiusY="2.8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#2E9D6A" Geometry="M14.5,25 L23,15.5 L29.5,21.5 L34,18 L42,25 Z" />
                        <GeometryDrawing Brush="#FFFFFF" Geometry="M23,15.5 L25.6,18.4 L24.2,17.8 L23,18.9 L21.8,17.8 L20.6,18.6 Z" />
                        <GeometryDrawing Brush="#237A52" Geometry="M14.5,25 V23.4 Q24,20.6 32,23 Q41,25.4 49.5,22.4 V25 Z" />
                    </DrawingGroup>
                </DrawingGroup>

                <!-- Eyebrows raised in surprise -->
                <GeometryDrawing Geometry="M19.5,33.5 Q23.5,30 28,32.2 M36,32.2 Q40.5,30 44.5,33.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1C3460" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Round eyes -->
                <GeometryDrawing Brush="#1F2A44">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="24,41" RadiusX="5" RadiusY="5.8" />
                            <EllipseGeometry Center="40,41" RadiusX="5" RadiusY="5.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Eye sparkles -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="22.2,38.8" RadiusX="2" RadiusY="2.2" />
                            <EllipseGeometry Center="38.2,38.8" RadiusX="2" RadiusY="2.2" />
                            <EllipseGeometry Center="25.9,43.5" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="41.9,43.5" RadiusX="0.9" RadiusY="0.9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Blush -->
                <GeometryDrawing Brush="#80FF5C8A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="15,49" RadiusX="4" RadiusY="2.6" />
                            <EllipseGeometry Center="49,49" RadiusX="4" RadiusY="2.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- "Oh!" open mouth and tongue -->
                <GeometryDrawing Brush="#1F2A44">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,51.5" RadiusX="3.4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF6F8E" Geometry="M29.4,53.4 C30.4,52.2 33.6,52.2 34.6,53.4 C34,55 32.8,55.5 32,55.5 C31.2,55.5 30,55 29.4,53.4 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Simplified version for 32 px and below (64x64 grid). Strokes and gaps are at least 4 units so they stay visible at 16 px. -->
    <DrawingImage x:Key="Op.AppIconSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />

                <!-- Body: same outline as the large version, one colour and a thick border -->
                <GeometryDrawing Brush="#7CC6F7" Geometry="M18,7 H46 C54,7 58,11 58.5,19 L60,44 C60.5,53 55,58.5 46,58.5 H18 C9,58.5 3.5,53 4,44 L5.5,19 C6,11 10,7 18,7 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2F6FC4" Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Photo: white frame, warm sky, one mountain, sun. Not tilted (a tilt blurs at 16 px). -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="12,11,40,18" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFE08A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16,14,32,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2E9D6A" Geometry="M16,26 L26,15 L36,26 Z" />
                <GeometryDrawing Brush="#FF8A3D">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="40,16,5,5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Two eyes and the mouth -->
                <GeometryDrawing Brush="#1F2A44">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="22,41" RadiusX="6" RadiusY="6" />
                            <EllipseGeometry Center="42,41" RadiusX="6" RadiusY="6" />
                            <EllipseGeometry Center="32,53" RadiusX="3" RadiusY="3" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
