<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts: Windows built-ins only (no bundled third-party fonts or symbol sets). -->
    <FontFamily x:Key="Op.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Op.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Op.BodySize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
    <sys:Double x:Key="Op.SecondarySize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:Double>

    <!-- Keyboard focus indicator (not shown for mouse clicks). -->
    <Style x:Key="Op.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource Op.Focus}" StrokeThickness="2" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Op.InsetFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" Stroke="{DynamicResource Op.Focus}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Op.WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Op.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Op.BodySize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource Op.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Op.SecondarySize}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="MaxWidth" Value="360" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar button: icon glyph (Tag) + short label (Content). Click target >= 32x32 DIP. -->
    <Style x:Key="Op.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Op.ChromeText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.FocusVisual}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Op.IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" TextElement.FontSize="{StaticResource Op.SecondarySize}" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Op.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Single primary action in accent colour. -->
    <Style x:Key="Op.ToolbarAccentButton" TargetType="Button" BasedOn="{StaticResource Op.ToolbarButton}">
        <Setter Property="Foreground" Value="{DynamicResource Op.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Op.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Op.IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" TextElement.FontSize="{StaticResource Op.SecondarySize}" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Op.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small toolbar: icon only (label in tooltip and AutomationProperties.Name). Click target 32x32 DIP. -->
    <Style x:Key="Op.ToolbarSmallButton" TargetType="Button" BasedOn="{StaticResource Op.ToolbarButton}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Op.IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Op.Border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Op.ToolbarSmallAccentButton" TargetType="Button" BasedOn="{StaticResource Op.ToolbarSmallButton}">
        <Setter Property="Foreground" Value="{DynamicResource Op.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Op.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Op.IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic toolbar: text only, bordered button. -->
    <Style x:Key="Op.ToolbarClassicButton" TargetType="Button" BasedOn="{StaticResource Op.ToolbarButton}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Op.ToolbarClassicAccentButton" TargetType="Button" BasedOn="{StaticResource Op.ToolbarClassicButton}">
        <Setter Property="Foreground" Value="{DynamicResource Op.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Op.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog and empty-state buttons. -->
    <Style x:Key="Op.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="Background" Value="{DynamicResource Op.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Op.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Op.IconButton" TargetType="Button" BasedOn="{StaticResource Op.Button}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Op.IconFont}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="Op.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Op.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Op.Focus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu: own template so it stays readable in dark and high contrast (standard menu bar behaviour unchanged). -->
    <Style x:Key="Op.Menu" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Op.Chrome}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.ChromeText}" />
        <Setter Property="FontFamily" Value="{StaticResource Op.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Op.BodySize}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>

    <!-- Menu separator: group boundary. In high contrast Op.Border is the system text colour. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="28,4,8,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Op.Border}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Op.ChromeText}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,5" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CheckCol" Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OpGesture" />
                                <ColumnDefinition x:Name="ArrowCol" Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Op.IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="32,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Op.IconFont}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" AllowsTransparency="False" Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Op.Background}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" Padding="2" MinWidth="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Grid.IsSharedSizeScope="True" TextElement.Foreground="{DynamicResource Op.Text}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Padding" Value="10,5" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="CheckCol" Property="Width" Value="0" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Padding" Value="10,5" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Op.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar tree. -->
    <Style x:Key="Op.TreeView" TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Op.Sidebar}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
    </Style>

    <!-- Detail grid. Row height 28 DIP, opaque. -->
    <Style x:Key="Op.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="RowBackground" Value="{DynamicResource Op.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Op.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <!-- Do not sync the ICollectionView CurrentItem (first row) into the selection. -->
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ClipboardCopyMode" Value="None" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Op.SecondaryText}" />
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="FontSize" Value="{StaticResource Op.SecondarySize}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <TextBlock x:Name="SortGlyph" Grid.Column="1" FontFamily="{StaticResource Op.IconFont}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Opacity="0" Cursor="SizeWE" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Opacity="0" Cursor="SizeWE" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70E;" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70D;" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding TypeName}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Op.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.InsetFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Op.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Op.OnSelection}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- List items: token selection colour (selection state is also exposed through UIA SelectionItem). -->
    <Style x:Key="Op.EntryListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.InsetFocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnSelection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Op.RightCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="Op.StatusBar" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Op.Chrome}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.ChromeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource Op.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Op.SecondarySize}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Context menus (tile menu, toolbar drop-downs): opaque token surface, same item template as the menu bar. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Op.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Op.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource Op.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Op.BodySize}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="2" MinWidth="200">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" TextElement.Foreground="{DynamicResource Op.Text}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.FocusVisual}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.FocusVisual}" />
    </Style>

    <!-- Details view rows. -->
    <Style x:Key="Op.DetailsItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Op.InsetFocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,2" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Op.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.OnSelection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Viewer edge buttons (previous/next): 64 DIP wide, visible only while the mouse is over them. Keyboard alternatives exist. -->
    <Style x:Key="Op.EdgeButton" TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Op.ChromeText}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Op.Chrome}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Op.IconFont}" FontSize="18" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Op.GridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</ResourceDictionary>
