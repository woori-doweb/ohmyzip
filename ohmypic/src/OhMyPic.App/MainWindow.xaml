<Window x:Class="OhMyPic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OhMyPic.App.Controls"
        xmlns:models="clr-namespace:OhMyPic.App.Models"
        xmlns:res="clr-namespace:OhMyPic.App.Text;assembly=OhMyPic.App.Text"
        Style="{StaticResource Op.WindowStyle}"
        Title="{x:Static res:DialogText.App_Name}"
        Width="1100" Height="720" MinWidth="640" MinHeight="420"
        AllowDrop="True"
        AutomationProperties.AutomationId="OP-MainWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Wrap layout (thumbnails, large icons, icons, list) and filmstrip strip. -->
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <controls:VirtualizingWrapPanel ItemWidth="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" ItemHeight="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StripPanelTemplate">
            <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Tile: thumbnail (generic glyph until loaded) + name. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type models:ImageItem}">
            <Grid Width="{Binding TileInnerWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding TileInnerHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="2">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Op.IconFont}" FontSize="28" Foreground="{DynamicResource Op.SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="2,2,2,0" />
            </Grid>
        </DataTemplate>

        <!-- Tile with the resolution line (setting "Show resolution on thumbnails"). -->
        <DataTemplate x:Key="TileResolutionTemplate" DataType="{x:Type models:ImageItem}">
            <Grid Width="{Binding TileInnerWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding TileInnerHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="2">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Op.IconFont}" FontSize="28" Foreground="{DynamicResource Op.SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="2,2,2,0" />
                <TextBlock Grid.Row="2" Text="{Binding DimensionsText}" HorizontalAlignment="Center" FontSize="{StaticResource Op.SecondarySize}" />
            </Grid>
        </DataTemplate>

        <!-- List: small picture + name on one line. -->
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type models:ImageItem}">
            <DockPanel Width="{Binding TileInnerWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding TileInnerHeight, RelativeSource={RelativeSource AncestorType=Window}}" LastChildFill="True">
                <Grid Width="20" Height="20" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Op.IconFont}" FontSize="14" Foreground="{DynamicResource Op.SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Style="{StaticResource Op.Menu}" AutomationProperties.AutomationId="OP-Menu" />

        <!-- Toolbar: one solid surface, two mode-specific button sets (design P03/P04). -->
        <Border x:Name="ToolbarHost" DockPanel.Dock="Top" Background="{DynamicResource Op.Chrome}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <StackPanel x:Name="BrowserToolbarPanel" Orientation="Horizontal" AutomationProperties.Name="{x:Static res:MainText.Toolbar_BrowserName}"
                            AutomationProperties.AutomationId="OP-Toolbar-Browser" />
                <StackPanel x:Name="ViewerToolbarPanel" Orientation="Horizontal" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:MainText.Toolbar_ViewerName}"
                            AutomationProperties.AutomationId="OP-Toolbar-Viewer" />
            </Grid>
        </Border>

        <!-- Address bar (browser only): Up + editable path. -->
        <Border x:Name="AddressBar" DockPanel.Dock="Top" Background="{DynamicResource Op.Chrome}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource Op.IconButton}" Content="&#xE74A;" MinHeight="32"
                        AutomationProperties.Name="{x:Static res:MenuText.Label_Up}" AutomationProperties.AutomationId="OP-Address-Up" />
                <TextBox x:Name="AddressBox" Style="{StaticResource Op.TextBox}" Margin="4,0,0,0"
                         AutomationProperties.Name="{x:Static res:MainText.Address_Name}" AutomationProperties.AutomationId="OP-Address-Path" />
            </DockPanel>
        </Border>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Style="{StaticResource Op.StatusBar}" AutomationProperties.AutomationId="OP-StatusBar">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="OP-Status-Text" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="StatusRightText" Grid.Column="1" Margin="16,0,0,0" AutomationProperties.AutomationId="OP-Status-Right" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <!-- Browser: folder tree | thumbnails | inspector (preview / camera info). -->
            <Grid x:Name="BrowserRoot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="0" />
                    <ColumnDefinition x:Name="TreeSplitterColumn" Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="280" />
                </Grid.ColumnDefinitions>

                <TreeView x:Name="FolderTree" Style="{StaticResource Op.TreeView}" AutomationProperties.Name="{x:Static res:MainText.Tree_Name}" AutomationProperties.AutomationId="OP-FolderTree">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource Op.Text}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="MinHeight" Value="26" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Op.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Style="{StaticResource Op.GridSplitter}" />

                <Grid x:Name="ListHost" Grid.Column="2" Background="{DynamicResource Op.Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="FilmstripPreviewRow" Height="0" />
                        <RowDefinition x:Name="ListRow" Height="*" />
                    </Grid.RowDefinitions>
                    <Image x:Name="FilmstripImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.AutomationId="OP-Filmstrip-Preview" />
                    <ListBox x:Name="TileList" Grid.Row="1" SelectionMode="Extended" BorderThickness="0" Padding="4"
                             Background="{DynamicResource Op.Background}" Foreground="{DynamicResource Op.Text}"
                             ItemContainerStyle="{StaticResource Op.EntryListItem}"
                             ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource TileTemplate}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{x:Static res:MainText.Browser_ListName}" AutomationProperties.AutomationId="OP-Thumbnails" />
                    <ListView x:Name="DetailsList" Grid.RowSpan="2" SelectionMode="Extended" BorderThickness="0" Visibility="Collapsed"
                              Background="{DynamicResource Op.Background}" Foreground="{DynamicResource Op.Text}"
                              ItemContainerStyle="{StaticResource Op.DetailsItem}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="{x:Static res:MainText.Browser_ListName}" AutomationProperties.AutomationId="OP-Details">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static res:MainText.Column_Name}" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{x:Static res:MainText.Column_Type}" Width="110" DisplayMemberBinding="{Binding TypeName}" />
                                <GridViewColumn Header="{x:Static res:MainText.Column_Size}" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="{x:Static res:MainText.Column_Modified}" Width="150" DisplayMemberBinding="{Binding ModifiedText}" />
                                <GridViewColumn Header="{x:Static res:MainText.Column_Dimensions}" Width="110" DisplayMemberBinding="{Binding DimensionsText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Op.SecondaryText}"
                               Text="{x:Static res:MainText.Browser_Empty}" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AutomationId="OP-Browser-Empty" />
                </Grid>

                <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Style="{StaticResource Op.GridSplitter}" />
                <Border x:Name="InspectorPane" Grid.Column="4" Background="{DynamicResource Op.Sidebar}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="12">
                            <StackPanel x:Name="PreviewSection" AutomationProperties.Name="{x:Static res:MenuText.Label_PanePreview}" AutomationProperties.AutomationId="OP-PreviewPane">
                                <TextBlock Text="{x:Static res:MainText.Pane_PreviewHeading}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource Op.Background}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" Height="200">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.AutomationId="OP-Preview-Image" />
                                </Border>
                                <TextBlock x:Name="PreviewName" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="OP-Preview-Name" />
                            </StackPanel>
                            <StackPanel x:Name="CameraSection" Margin="0,16,0,0" AutomationProperties.Name="{x:Static res:MenuText.Label_PaneCamera}" AutomationProperties.AutomationId="OP-CameraPane">
                                <TextBlock Text="{x:Static res:MainText.Pane_CameraHeading}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl x:Name="CameraList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:InfoRow}">
                                            <Grid Margin="0,2" AutomationProperties.Name="{Binding Accessible}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Op.SecondaryText}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="CameraEmpty" Text="{x:Static res:MainText.Pane_CameraEmpty}" Foreground="{DynamicResource Op.SecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Viewer: the image fills the client area (design P01). Focusable root so viewer keys reach the window bindings. -->
            <Grid x:Name="ViewerRoot" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" ClipToBounds="True"
                  AutomationProperties.AutomationId="OP-Viewer">
                <ScrollViewer x:Name="ViewerScroll" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                    <Image x:Name="ViewerImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="OP-Viewer-Image" />
                </ScrollViewer>

                <StackPanel x:Name="ViewerError" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="Collapsed"
                            AutomationProperties.AutomationId="OP-Viewer-Error">
                    <TextBlock Text="&#xEA39;" FontFamily="{StaticResource Op.IconFont}" FontSize="32" Foreground="{DynamicResource Op.Error}" HorizontalAlignment="Center"
                               AutomationProperties.Name="{x:Static res:DialogText.Message_KindError}" />
                    <TextBlock x:Name="ViewerErrorHeading" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Op.Text}" />
                    <TextBlock x:Name="ViewerErrorBody" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Op.Text}" />
                </StackPanel>

                <Button x:Name="PrevEdgeButton" Style="{StaticResource Op.EdgeButton}" HorizontalAlignment="Left" Tag="&#xE76B;"
                        AutomationProperties.Name="{x:Static res:MenuText.Label_Previous}" AutomationProperties.AutomationId="OP-Viewer-PreviousEdge" />
                <Button x:Name="NextEdgeButton" Style="{StaticResource Op.EdgeButton}" HorizontalAlignment="Right" Tag="&#xE76C;"
                        AutomationProperties.Name="{x:Static res:MenuText.Label_Next}" AutomationProperties.AutomationId="OP-Viewer-NextEdge" />

                <!-- File name in full screen (setting). Opaque label. -->
                <Border x:Name="FullScreenName" Background="{DynamicResource Op.Chrome}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" CornerRadius="4"
                        Padding="10,4" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="FullScreenNameText" Foreground="{DynamicResource Op.ChromeText}" AutomationProperties.AutomationId="OP-Viewer-FullScreenName" />
                </Border>

                <!-- Navigator: whole image with the visible part outlined, shown while the image is larger than the window. -->
                <Border x:Name="NavigatorBorder" Background="{DynamicResource Op.Chrome}" BorderBrush="{DynamicResource Op.Border}" BorderThickness="1" Padding="4"
                        Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False"
                        AutomationProperties.Name="{x:Static res:MainText.Navigator_Name}" AutomationProperties.AutomationId="OP-Viewer-Navigator">
                    <Grid x:Name="NavigatorHost">
                        <Image x:Name="NavigatorImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Canvas>
                            <Rectangle x:Name="NavigatorRect" Stroke="{DynamicResource Op.Accent}" StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
