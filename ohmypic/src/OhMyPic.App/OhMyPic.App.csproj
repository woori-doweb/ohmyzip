<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OhMyPic.Core\OhMyPic.Core.csproj" />
    <ProjectReference Include="..\OhMyPic.App.Text\OhMyPic.App.Text.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ohMypic</AssemblyName>
    <RootNamespace>OhMyPic.App</RootNamespace>
    <Product>ohMypic</Product>
    <AssemblyTitle>ohMypic</AssemblyTitle>
    <Description>ohMypic image browser and viewer</Description>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UI strings live in OhMyPic.App.Text (English neutral + ko satellite). No other framework satellites. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Generated from Theme/AppIcon.xaml by packaging/make_icon.ps1. -->
  <PropertyGroup Condition="Exists('ohMypic.ico')">
    <ApplicationIcon>ohMypic.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="HELP.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HELP.ko.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
