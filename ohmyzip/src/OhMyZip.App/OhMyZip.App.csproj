<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OhMyZip.Core\OhMyZip.Core.csproj" />
    <ProjectReference Include="..\OhMyZip.App.Text\OhMyZip.App.Text.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ohmyZip</AssemblyName>
    <RootNamespace>OhMyZip.App</RootNamespace>
    <Product>ohmyZip</Product>
    <AssemblyTitle>ohmyZip</AssemblyTitle>
    <Description>ohmyZip archive manager</Description>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- packaging/make_icon.ps1 이 Theme/AppIcon.xaml 에서 생성 -->
    <ApplicationIcon>ohmyZip.ico</ApplicationIcon>
    <!-- 화면 문구는 OhMyZip.App.Text(영어 기본 + ko 위성). 다른 언어의 프레임워크 위성은 넣지 않는다. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="HELP.md" Condition="Exists('HELP.md')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HELP.en.md" Condition="Exists('HELP.en.md')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 탐색기 하위 메뉴 명령 처리기(네이티브 x64). DLL 이 없거나 원본보다 오래되면 build.py 로 다시 만든다. -->
  <PropertyGroup>
    <ShellCommandDir>$(MSBuildThisFileDirectory)..\ShellCommand\</ShellCommandDir>
    <ShellCommandDll>$(ShellCommandDir)bin\x64\ShellCommand.dll</ShellCommandDll>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(ShellCommandDll)" Link="ShellCommand.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildShellCommand" BeforeTargets="BeforeBuild"
          Inputs="$(ShellCommandDir)ShellCommand.cpp;$(ShellCommandDir)ShellCommand.def;$(ShellCommandDir)build.py"
          Outputs="$(ShellCommandDll)">
    <Exec Command="python -X utf8 &quot;$(ShellCommandDir)build.py&quot;" />
  </Target>

</Project>
