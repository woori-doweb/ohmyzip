<UserControl x:Class="OhMyZip.App.Controls.AppLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
             Width="64" Height="64" Focusable="False" AutomationProperties.Name="{x:Static res:MainText.AppLogo_Name}">
    <!-- 그림 정본은 Theme/AppIcon.xaml(실행 파일 아이콘과 같은 그림). -->
    <Image Source="{StaticResource Oz.AppIcon}" Stretch="Uniform" />
</UserControl>
