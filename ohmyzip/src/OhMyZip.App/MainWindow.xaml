<Window x:Class="OhMyZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OhMyZip.App.Models"
        xmlns:controls="clr-namespace:OhMyZip.App.Controls"
        xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
        Style="{StaticResource Oz.WindowStyle}"
        Title="ohmyZip" Width="1040" Height="660" MinWidth="720" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <!-- 파일 목록 '간단히'·'아이콘'·'큰 아이콘' 방식(보기 > 파일 목록). '자세히' 는 DataGrid. -->
        <DataTemplate x:Key="Oz.ListTemplate" DataType="{x:Type models:EntryRow}">
            <StackPanel Orientation="Horizontal" Width="220" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Oz.IconTemplate" DataType="{x:Type models:EntryRow}">
            <StackPanel Width="96" Margin="2,4">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Oz.LargeIconTemplate" DataType="{x:Type models:EntryRow}">
            <StackPanel Width="136" Margin="4,6">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="56" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Oz.VerticalWrap">
            <WrapPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Oz.HorizontalWrap">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- 1. Windows 메뉴 막대: 메뉴 7개·58항목(+ 기능 행 명령). CommandCatalog 에서 생성. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Style="{StaticResource Oz.Menu}" AutomationProperties.Name="{x:Static res:MainText.MenuBar_Name}" />

        <!-- 2. 툴바: 단색 표면, 3묶음 + 검색. 버튼은 CommandCatalog.ToolbarGroups 에서 생성. -->
        <Border x:Name="ToolbarHost" DockPanel.Dock="Top" Background="{DynamicResource Oz.Chrome}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="{x:Static res:MainText.Toolbar_Name}" />
                <Grid Grid.Column="1" Width="260" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Oz.TextBox}" Padding="28,0,6,0"
                             AutomationProperties.Name="{x:Static res:MainText.FindBox_Name}" AutomationProperties.AutomationId="OZ-FindBox"
                             ToolTip="{x:Static res:MainText.FindBox_ToolTip}"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Oz.IconFont}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Oz.SecondaryText}" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Text="{x:Static res:MainText.FindBox_Name}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Oz.SecondaryText}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. 상태줄: 정보만, 조작 버튼 없음. 알림 문장이 바뀌면 화면 읽기 프로그램이 읽는다(LiveSetting). -->
        <StatusBar x:Name="StatusBarHost" DockPanel.Dock="Bottom" Style="{StaticResource Oz.StatusBar}" AutomationProperties.Name="{x:Static res:MainText.StatusBar_Name}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Oz.ChromeText}" AutomationProperties.AutomationId="OZ-StatusText"
                           AutomationProperties.LiveSetting="Polite"
                           ToolTip="{x:Static res:MainText.Status_FolderHelp}"
                           AutomationProperties.HelpText="{x:Static res:MainText.Status_FolderHelp}" />
            </StatusBarItem>
        </StatusBar>

        <!-- 3. 콘텐츠: 사이드바 트리 | 파일 목록. 빈 상태는 위에 겹쳐 보인다. -->
        <Grid Background="{DynamicResource Oz.Background}">
            <Grid x:Name="BrowserGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230" MinWidth="120" MaxWidth="600" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarHost" Background="{DynamicResource Oz.Sidebar}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="FolderTree" Style="{StaticResource Oz.TreeView}" AutomationProperties.Name="{x:Static res:MainText.FolderTree_Name}"
                              SelectedItemChanged="OnTreeSelectionChanged" PreviewKeyDown="OnBrowseKeyDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource Oz.InsetFocusVisual}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource Oz.GridSplitter}" ResizeBehavior="PreviousAndNext" />

                <DockPanel Grid.Column="2">
                    <!-- 경로 표시줄: 깊은 경로 보완. -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,0,1" Padding="6,4">
                        <DockPanel>
                            <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource Oz.IconButton}" Content="&#xE74A;" IsTabStop="False"
                                    AutomationProperties.Name="{x:Static res:MainText.Up_Name}" ToolTip="{x:Static res:MainText.Up_ToolTip}" Click="OnUpClick" />
                            <TextBlock x:Name="PathText" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="{x:Static res:MainText.PathText_Name}" />
                        </DockPanel>
                    </Border>

                    <!-- 압축 파일 설명 창(F8). -->
                    <Border x:Name="CommentPane" DockPanel.Dock="Bottom" Visibility="Collapsed" MaxHeight="160"
                            Background="{DynamicResource Oz.Chrome}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,1,0,0" Padding="8,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:MainText.CommentPane_Heading}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="CommentText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Oz.Text}" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{x:Static res:MainText.CommentPane_Heading}" AutomationProperties.AutomationId="OZ-CommentPane" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <DataGrid x:Name="EntryGrid" Style="{StaticResource Oz.DataGrid}" AutomationProperties.Name="{x:Static res:MainText.FileList_Name}" AutomationProperties.AutomationId="OZ-EntryGrid"
                                  Sorting="OnGridSorting" MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnBrowseKeyDown"
                                  SelectionChanged="OnGridSelectionChanged" GotKeyboardFocus="OnGridGotKeyboardFocus"
                                  PreviewMouseRightButtonUp="OnGridHeaderRightClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static res:MainText.Column_Name}" SortMemberPath="Name" Width="2*" MinWidth="160" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:EntryRow}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColCompressed" Header="{x:Static res:MainText.Column_PackedSize}" Binding="{Binding CompressedSizeText}" SortMemberPath="CompressedSize" Width="100" ElementStyle="{StaticResource Oz.RightCell}" />
                                <DataGridTextColumn x:Name="ColSize" Header="{x:Static res:MainText.Column_Size}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" ElementStyle="{StaticResource Oz.RightCell}" />
                                <DataGridTextColumn x:Name="ColType" Header="{x:Static res:MainText.Column_Type}" Binding="{Binding TypeName}" SortMemberPath="TypeName" Width="140" />
                                <DataGridTextColumn x:Name="ColModified" Header="{x:Static res:MainText.Column_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="150" />
                                <DataGridTextColumn x:Name="ColMethod" Header="{x:Static res:MainText.Column_Method}" Binding="{Binding MethodText}" SortMemberPath="MethodText" Width="100" />
                                <DataGridTextColumn x:Name="ColEncryption" Header="{x:Static res:MainText.Column_Encryption}" Binding="{Binding EncryptionText}" SortMemberPath="EncryptionText" Width="130" />
                                <DataGridTextColumn x:Name="ColCrc" Header="CRC" Binding="{Binding CrcText}" SortMemberPath="Crc32" Width="90" />
                                <DataGridTextColumn x:Name="ColAttributes" Header="{x:Static res:MainText.Column_Attributes}" Binding="{Binding AttributesText}" CanUserSort="False" Width="70" />
                                <DataGridTextColumn x:Name="ColDescription" Header="{x:Static res:MainText.Column_Description}" Binding="{Binding DescriptionText}" CanUserSort="False" Width="120" />
                                <DataGridTextColumn x:Name="ColExtra" Header="{x:Static res:MainText.Column_ExtraInfo}" Binding="{Binding ExtraText}" CanUserSort="False" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 간단히·아이콘·큰 아이콘. 선택이 없으면 '전체 풀기' 가 되도록 처음 선택을 두지 않는다(DEF-01). -->
                        <ListBox x:Name="EntryList" Visibility="Collapsed" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                                 Background="{DynamicResource Oz.Background}" Foreground="{DynamicResource Oz.Text}" BorderThickness="0" Padding="4"
                                 ItemContainerStyle="{StaticResource Oz.EntryListItem}"
                                 AutomationProperties.Name="{x:Static res:MainText.FileList_Name}" AutomationProperties.AutomationId="OZ-EntryList"
                                 MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnBrowseKeyDown" SelectionChanged="OnGridSelectionChanged" />

                        <!-- 찾기 결과(Ctrl+F): 압축 파일 전체에서 이름이 맞는 항목의 전체 경로. -->
                        <DockPanel x:Name="FindPanel" Visibility="Collapsed" Background="{DynamicResource Oz.Background}">
                            <TextBlock x:Name="FindSummary" DockPanel.Dock="Top" Margin="8,6" Foreground="{DynamicResource Oz.SecondaryText}"
                                       AutomationProperties.AutomationId="OZ-FindSummary" />
                            <ListBox x:Name="FindResults" SelectionMode="Single" Background="{DynamicResource Oz.Background}" Foreground="{DynamicResource Oz.Text}"
                                     BorderThickness="0" Padding="4" ItemContainerStyle="{StaticResource Oz.EntryListItem}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="{x:Static res:MainText.FindResults_Name}" AutomationProperties.AutomationId="OZ-FindResults"
                                     PreviewKeyDown="OnFindResultsKeyDown" MouseDoubleClick="OnFindResultsDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FindHit}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Oz.IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- 빈 상태(시작 화면). -->
            <Grid x:Name="EmptyState" Background="{DynamicResource Oz.Background}">
                <StackPanel x:Name="StartContent" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <controls:AppLogo HorizontalAlignment="Center" />
                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="15"
                               Text="{x:Static res:MainText.Start_Prompt}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="EmptyOpenButton" Content="{x:Static res:MainText.StartOpen_Button}" Style="{StaticResource Oz.Button}" AutomationProperties.Name="{x:Static res:MainText.StartOpen_Button}" />
                        <Button x:Name="EmptyCreateButton" Content="{x:Static res:MainText.StartNewArchive_Button}" Style="{StaticResource Oz.Button}" AutomationProperties.Name="{x:Static res:MainText.StartNewArchive_Button}" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyReturnHint" Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                               Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                               Text="{x:Static res:MainText.Start_ReturnHint}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
