<Window x:Class="OhMyZip.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OhMyZip.App.Controls"
        xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
        Style="{StaticResource Oz.WindowStyle}"
        Title="{x:Static res:DialogText.About_Title}" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-AboutWindow">
    <StackPanel Margin="24,22,24,18">
        <StackPanel Orientation="Horizontal">
            <controls:AppLogo Width="56" Height="56" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ohmyZip" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                           AutomationProperties.AutomationId="OZ-About-Version" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap"
                   Text="{x:Static res:DialogText.About_Description}" />
        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:DialogText.About_ThirdPartyHeading}" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                   Text="{x:Static res:DialogText.About_ThirdPartyNotices}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:DialogText.Ok_Button}" IsDefault="True" IsCancel="True" Style="{StaticResource Oz.Button}" />
        </StackPanel>
    </StackPanel>
</Window>
