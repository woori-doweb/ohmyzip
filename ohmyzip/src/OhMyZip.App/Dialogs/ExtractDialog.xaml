<Window x:Class="OhMyZip.App.Dialogs.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
        Style="{StaticResource Oz.WindowStyle}"
        Title="{x:Static res:DialogText.Extract_Title}" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-ExtractDialog">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="DestinationLabel" Text="{x:Static res:DialogText.Extract_DestinationLabel}" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Extract_NewFolder_Button}" Style="{StaticResource Oz.Button}" Margin="6,0,0,0" Click="OnNewFolder"
                    AutomationProperties.AutomationId="OZ-Extract-NewFolder" ToolTip="{x:Static res:DialogText.Extract_NewFolderTip}" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Browse_Button}" Style="{StaticResource Oz.Button}" Margin="6,0,0,0" Click="OnBrowse"
                    AutomationProperties.AutomationId="OZ-Extract-Browse" />
            <TextBox x:Name="DestinationBox" Style="{StaticResource Oz.TextBox}" TextChanged="OnDestinationChanged"
                     AutomationProperties.LabeledBy="{Binding ElementName=DestinationLabel}" AutomationProperties.AutomationId="OZ-Extract-Destination" />
        </DockPanel>
        <TextBlock x:Name="DestinationHint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Oz.SecondaryText}" FontSize="{StaticResource Oz.SecondarySize}"
                   AutomationProperties.AutomationId="OZ-Extract-DestinationHint" />

        <TextBlock Text="{x:Static res:DialogText.Extract_ScopeLabel}" Margin="0,14,0,4" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ScopeAll" Content="{x:Static res:DialogText.Extract_ScopeAll}" GroupName="Scope" Foreground="{DynamicResource Oz.Text}" Margin="0,0,18,0"
                         AutomationProperties.AutomationId="OZ-Extract-ScopeAll" />
            <RadioButton x:Name="ScopeSelected" GroupName="Scope" Foreground="{DynamicResource Oz.Text}"
                         AutomationProperties.AutomationId="OZ-Extract-ScopeSelected" />
        </StackPanel>

        <TextBlock x:Name="ConflictLabel" Text="{x:Static res:DialogText.Extract_ConflictLabel}" Margin="0,14,0,4" />
        <ComboBox x:Name="ConflictBox" MinHeight="30" AutomationProperties.LabeledBy="{Binding ElementName=ConflictLabel}"
                  AutomationProperties.AutomationId="OZ-Extract-Conflict" />

        <CheckBox x:Name="OpenAfterBox" Content="{x:Static res:DialogText.OpenFolderAfterExtract}" Margin="0,14,0,0" Foreground="{DynamicResource Oz.Text}"
                  AutomationProperties.AutomationId="OZ-Extract-OpenAfter" />

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Oz.Error}" Visibility="Collapsed"
                   AutomationProperties.AutomationId="OZ-Extract-Error" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:DialogText.Extract_Ok_Button}" IsDefault="True" Style="{StaticResource Oz.Button}" Click="OnOk" AutomationProperties.AutomationId="OZ-Extract-Ok" />
            <Button Content="{x:Static res:DialogText.Cancel_Button}" IsCancel="True" Style="{StaticResource Oz.Button}" AutomationProperties.AutomationId="OZ-Extract-Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
