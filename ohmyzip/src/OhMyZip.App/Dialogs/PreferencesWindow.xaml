<Window x:Class="OhMyZip.App.Dialogs.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:OhMyZip.App.Text;assembly=OhMyZip.App.Text"
        Style="{StaticResource Oz.WindowStyle}"
        Title="{x:Static res:DialogText.Pref_Title}" Width="720" Height="500" MinWidth="600" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OZ-PreferencesWindow">
    <Window.Resources>
        <Style x:Key="Pref.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Pref.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Pref.Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Oz.SecondaryText}" />
            <Setter Property="FontSize" Value="{StaticResource Oz.SecondarySize}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Oz.Text}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{x:Static res:DialogText.Pref_Reset_Button}" Style="{StaticResource Oz.Button}" Margin="0" Click="OnReset" AutomationProperties.AutomationId="OZ-Pref-Reset"
                    ToolTip="{x:Static res:DialogText.Pref_ResetTip}" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Cancel_Button}" IsCancel="True" Style="{StaticResource Oz.Button}" AutomationProperties.AutomationId="OZ-Pref-Cancel" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:DialogText.Ok_Button}" IsDefault="True" Style="{StaticResource Oz.Button}" Click="OnOk" AutomationProperties.AutomationId="OZ-Pref-Ok" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Oz.Border}" />

        <!-- 설정 범주 9개(순서 고정, OZ-U10). -->
        <Border DockPanel.Dock="Left" Width="170" Background="{DynamicResource Oz.Sidebar}" BorderBrush="{DynamicResource Oz.Border}" BorderThickness="0,0,1,0">
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="4,8" Foreground="{DynamicResource Oz.Text}"
                     SelectionChanged="OnCategoryChanged" AutomationProperties.Name="{x:Static res:DialogText.Pref_CategoriesName}" AutomationProperties.AutomationId="OZ-Pref-Categories">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid x:Name="Pages">
                <!-- 0 일반 설정 -->
                <StackPanel>
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_General}" />
                    <CheckBox x:Name="ShowStartScreenBox" Content="{x:Static res:DialogText.Pref_ShowStartScreen}" AutomationProperties.AutomationId="OZ-Pref-ShowStartScreen" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_StartScreenNote}" />
                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_ThemeLabel}" />
                    <ComboBox x:Name="ThemeBox" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" AutomationProperties.AutomationId="OZ-Pref-Theme" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_ThemeNote}" />
                    <CheckBox x:Name="ReduceMotionBox" Content="{x:Static res:DialogText.Pref_ReduceMotion}" Margin="0,14,0,0" AutomationProperties.AutomationId="OZ-Pref-ReduceMotion" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_ReduceMotionNote}" />
                    <CheckBox x:Name="AutoUpdateBox" Content="{x:Static res:DialogText.Pref_AutoUpdate}" Margin="0,14,0,0" AutomationProperties.AutomationId="OZ-Pref-AutoUpdate" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_AutoUpdateNote}" />
                </StackPanel>

                <!-- 1 파일 연결 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_FileAssoc}" />
                    <TextBlock x:Name="FileAssocStatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-FileAssoc"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="FileAssocExtensionsText" Style="{StaticResource Pref.Note}" Margin="0,10,0,0" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Extensions" />
                    <TextBlock Style="{StaticResource Pref.Note}"
                               Text="{x:Static res:DialogText.Pref_FileAssocNote}" />
                    <WrapPanel Orientation="Horizontal" Margin="-4,14,0,0">
                        <Button x:Name="FileAssocRegisterButton" Content="{x:Static res:DialogText.Pref_FileAssocRegister_Button}" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocRegister" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Register" />
                        <Button x:Name="FileAssocUnregisterButton" Content="{x:Static res:DialogText.Pref_FileAssocUnregister_Button}" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocUnregister" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-Unregister" />
                        <Button Content="{x:Static res:DialogText.Pref_FileAssocOpenSettings_Button}" Style="{StaticResource Oz.Button}" Margin="4,0,4,8"
                                Click="OnFileAssocOpenSettings" AutomationProperties.AutomationId="OZ-Pref-FileAssoc-OpenSettings" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Pref.Note}"
                               Text="{x:Static res:DialogText.Pref_FileAssocImmediateNote}" />
                </StackPanel>

                <!-- 2 탐색기 메뉴 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_ShellMenu}" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-ShellMenu"
                               Text="{x:Static res:DialogText.Pref_ShellMenuStatus}" />
                </StackPanel>

                <!-- 3 압축 풀기 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_Extract}" />
                    <TextBlock x:Name="DestinationLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_DestinationLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="DestinationBox" AutomationProperties.LabeledBy="{Binding ElementName=DestinationLabel}" AutomationProperties.AutomationId="OZ-Pref-ExtractDestination" />
                    <TextBlock x:Name="ConflictLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_ConflictLabel}" />
                    <ComboBox x:Name="ConflictBox" AutomationProperties.LabeledBy="{Binding ElementName=ConflictLabel}" AutomationProperties.AutomationId="OZ-Pref-ExtractConflict" />
                    <CheckBox x:Name="OpenAfterBox" Content="{x:Static res:DialogText.OpenFolderAfterExtract}" Margin="0,14,0,0" AutomationProperties.AutomationId="OZ-Pref-OpenFolderAfterExtract" />
                </StackPanel>

                <!-- 4 압축하기 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_Create}" />
                    <TextBlock x:Name="FormatLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_FormatLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="FormatBox" AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}" AutomationProperties.AutomationId="OZ-Pref-CreateFormat" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_FormatNote}" />
                    <TextBlock x:Name="LevelLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_LevelLabel}" />
                    <ComboBox x:Name="LevelBox" AutomationProperties.LabeledBy="{Binding ElementName=LevelLabel}" AutomationProperties.AutomationId="OZ-Pref-CreateLevel" />
                </StackPanel>

                <!-- 5 보기/편집 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_ViewEdit}" />
                    <CheckBox x:Name="ConfirmDeleteBox" Content="{x:Static res:DialogText.Pref_ConfirmDelete}" Margin="0" AutomationProperties.AutomationId="OZ-Pref-ConfirmDelete" />
                    <TextBlock x:Name="ListModeLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_ListModeLabel}" Margin="0,14,0,4" />
                    <ComboBox x:Name="ListModeBox" AutomationProperties.LabeledBy="{Binding ElementName=ListModeLabel}" AutomationProperties.AutomationId="OZ-Pref-ListMode" />
                    <TextBlock Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_ColumnsLabel}" Margin="0,14,0,0" />
                    <WrapPanel x:Name="ColumnPanel" Orientation="Horizontal" AutomationProperties.Name="{x:Static res:DialogText.Pref_ColumnsName}" AutomationProperties.AutomationId="OZ-Pref-Columns" />
                </StackPanel>

                <!-- 6 보안 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_Security}" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-Security"
                               Text="{x:Static res:DialogText.Pref_SecurityStatus}" />
                </StackPanel>

                <!-- 7 고급 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_Advanced}" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="OZ-Pref-Status-Advanced"
                               Text="{x:Static res:DialogText.Pref_AdvancedStatus}" />
                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource Pref.Note}" Margin="0,12,0,0" AutomationProperties.AutomationId="OZ-Pref-SettingsPath" />
                </StackPanel>

                <!-- 8 언어 설정 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Pref.Heading}" Text="{x:Static res:DialogText.Pref_Category_Language}" />
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource Pref.Label}" Text="{x:Static res:DialogText.Pref_LanguageLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="LanguageBox" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" AutomationProperties.AutomationId="OZ-Pref-Language" />
                    <TextBlock Style="{StaticResource Pref.Note}" Text="{x:Static res:DialogText.Pref_LanguageNote}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
